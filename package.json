{
  "name": "edmar-cxc-maths",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev",
    "build": "turbo build --filter=@edmar/web",
    "check:invariants": "node scripts/check-no-secrets.mjs && node scripts/check-no-ai-in-client.mjs && node scripts/check-no-service-role.mjs && node scripts/check-entitlement.mjs && node scripts/check-no-hardcoded-questions.mjs",
    "test": "turbo test && node scripts/test-boundaries.mjs",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "test:db": "supabase test db",
  "test:crosscheck": "tsx scripts/crosscheck-answer-core.ts",
    "gen:taxonomy": "node scripts/gen-taxonomy-seed.mjs",
    "extract:syllabus": "python scripts/extract-syllabus.py"
  },
  "devDependencies": {
    "@edmar/answer-core": "workspace:*",
    "@edmar/types": "workspace:*",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}

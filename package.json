{
  "name": "edmar-cxc-maths",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev",
    "build": "turbo build --filter=@edmar/web",
    "check:invariants": "node scripts/check-no-secrets.mjs && node scripts/check-no-ai-in-client.mjs && node scripts/check-no-service-role.mjs && node scripts/check-entitlement.mjs && node scripts/check-no-hardcoded-questions.mjs && node scripts/check-projection-vocabulary.mjs",
    "test:pipeline": "python -m pytest apps/pipeline/tests -q",
    "test": "turbo test && node scripts/test-boundaries.mjs",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "test:db": "supabase test db",
    "test:crosscheck": "tsx scripts/crosscheck-answer-core.ts",
    "test:scripts": "vitest run --config vitest.config.ts",
    "render-math": "tsx scripts/render-math.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:staging": "tsx scripts/validate-staging.ts",
    "convert:workbook": "tsx scripts/convert-questions-with-solutions.ts",
    "gen:taxonomy": "node scripts/gen-taxonomy-seed.mjs",
    "extract:syllabus": "python scripts/extract-syllabus.py"
  },
  "devDependencies": {
    "@edmar/answer-core": "workspace:*",
    "@edmar/content-schema": "workspace:*",
    "@edmar/types": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "mathjax-full": "^3.2.2",
    "pg": "^8.23.0"
  }
}

  "stemBlocks": [
    {
      "type": "text",
      "value": "Determine to three significant figures: (i) √18  (ii) the reciprocal of 7."
    },
    {
      "type": "text",
      "value": "Think first: Work each value out to at least four figures first, then round once at the end."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p010_q11.jpg",
      "altText": "Source visual for edmar-csec-p010-q11 from workbook page 10."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Evaluate the square root in (i).",
      "contentBlocks": [
        {
          "type": "text",
          "value": "18 lies between 16 and 25, so the root is between 4 and 5; √18 = 4.2426…"
        },
        {
          "type": "text",
          "value": "Result: 4.2426…"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Round it to three significant figures.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "The first three figures are 4, 2 and 4; the next digit is 2, which is less than 5"
        },
        {
          "type": "text",
          "value": "Result: 4.24"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Write the reciprocal in (ii).",
      "contentBlocks": [
        {
          "type": "text",
          "value": "The reciprocal of 7 is 1 ÷ 7"
        },
        {
          "type": "text",
          "value": "Result: 1/7"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Convert to a decimal.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "1 ÷ 7 = 0.142857…"
        },
        {
          "type": "text",
          "value": "Result: 0.142857…"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Round it to three significant figures.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "The first three figures are 1, 4 and 2; the next digit is 8, so round up"
        },
        {
          "type": "text",
          "value": "Result: 0.143"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Evaluate √18 and 1/7 to more figures than you need, then round each to three significant figures."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(i) 4.24  (ii) 0.143"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Significant figures start at the first non-zero digit, so the zero in 0.142857 is a place-holder and is not counted — that is why the answer to (ii) keeps three digits after it. Rounding at the end rather than partway through matters because each early round throws away information the next step needs; carrying one extra digit is enough to protect the third."
    }
  ],

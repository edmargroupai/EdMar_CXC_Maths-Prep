  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 6m − 9 + 4mn − 6n"
    },
    {
      "type": "text",
      "value": "Think first: Pair the terms in the order given and watch the signs — they decide whether the brackets will match."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p092_q02.jpg",
      "altText": "Source visual for edmar-csec-p092-q02 from workbook page 92."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Group the terms in pairs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(6m − 9) + (4mn − 6n)"
        },
        {
          "type": "text",
          "value": "Result: Two pairs"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Take the common factor out of each pair.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 from 6m − 9, and 2n from 4mn − 6n"
        },
        {
          "type": "text",
          "value": "Result: 3(2m − 3) + 2n(2m − 3)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Take out the common bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Both terms contain (2m − 3)"
        },
        {
          "type": "text",
          "value": "Result: (2m − 3)(3 + 2n)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Group the first two and the last two terms, take the common factor out of each pair, then take out the bracket that both share."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(2m − 3)(3 + 2n)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Grouping works because factorising each pair reveals the same bracket in both terms, and that bracket can then be taken out exactly like a common number or letter. Expanding the answer returns the four original terms, which is the check."
    }
  ],

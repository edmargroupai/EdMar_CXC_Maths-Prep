  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify (8x⁴ × 2x⁵) / (4x⁵)."
    },
    {
      "type": "text",
      "value": "Think first: The x⁵ on the top and the x⁵ on the bottom are not the whole story, so combine the top first."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p065_q18.jpg",
      "altText": "Source visual for edmar-csec-p065-q18 from workbook page 65."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the coefficients in the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8 × 2 = 16"
        },
        {
          "type": "text",
          "value": "Result: 16"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add the indices in the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x⁴ × x⁵ = x^(4+5)"
        },
        {
          "type": "text",
          "value": "Result: 16x⁹"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "16 ÷ 4 = 4"
        },
        {
          "type": "text",
          "value": "Result: 4"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Subtract the indices.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x⁹ ÷ x⁵ = x^(9−5)"
        },
        {
          "type": "text",
          "value": "Result: 4x⁴"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply out the numerator, then divide coefficients and subtract indices."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(8x⁴ × 2x⁵) / (4x⁵) = 4x⁴"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Cancelling only works between a single factor on top and a single factor on the bottom. Here the numerator is a product of two powers, so it must be collapsed into one power before the division law applies. Once it is 16x⁹ over 4x⁵, dividing coefficients and subtracting indices is a single clean step."
    }
  ],

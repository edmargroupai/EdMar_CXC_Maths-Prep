  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 24a²b − 18ab²."
    },
    {
      "type": "text",
      "value": "Think first: Look for the HCF of 24 and 18 as well as the shared letters."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q12.jpg",
      "altText": "Source visual for edmar-csec-p066-q12 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "24 = 6 × 4 and 18 = 6 × 3"
        },
        {
          "type": "text",
          "value": "Result: 6"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find the lowest power of each letter.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "a² and a give a; b and b² give b"
        },
        {
          "type": "text",
          "value": "Result: ab"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Combine into the full HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6 × a × b"
        },
        {
          "type": "text",
          "value": "Result: 6ab"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide each term by 6ab.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "24a²b ÷ 6ab = 4a and 18ab² ÷ 6ab = 3b"
        },
        {
          "type": "text",
          "value": "Result: 4a and 3b"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 6ab(4a − 3b)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find the numerical HCF and the lowest power of a and of b, combine them, then divide each term."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "24a²b − 18ab² = 6ab(4a − 3b)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Removing the highest common factor in one move is what makes the factorisation complete. If a smaller factor such as 2ab were taken out, the bracket 12a − 9b would still share a factor of 3 and the work would be unfinished. Checking the bracket for leftover common factors is the test that the HCF was correct."
    }
  ],

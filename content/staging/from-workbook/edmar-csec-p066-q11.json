  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 14m²n + 21mn²."
    },
    {
      "type": "text",
      "value": "Think first: Both letters appear in both terms, so both belong in the common factor."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q11.jpg",
      "altText": "Source visual for edmar-csec-p066-q11 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "14 = 2 × 7 and 21 = 3 × 7"
        },
        {
          "type": "text",
          "value": "Result: 7"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find the lowest power of each letter.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "m² and m give m; n and n² give n"
        },
        {
          "type": "text",
          "value": "Result: mn"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Combine into the full HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7 × m × n"
        },
        {
          "type": "text",
          "value": "Result: 7mn"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide each term by 7mn.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "14m²n ÷ 7mn = 2m and 21mn² ÷ 7mn = 3n"
        },
        {
          "type": "text",
          "value": "Result: 2m and 3n"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 7mn(2m + 3n)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Take the numerical HCF and the lowest power of each letter, then divide each term by the result."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "14m²n + 21mn² = 7mn(2m + 3n)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "With more than one letter, the highest common factor is assembled letter by letter, each taken to the lowest index it reaches across all the terms. Here m appears as m² and m¹, so m¹ comes out; n appears as n¹ and n², so n¹ comes out. What remains in the bracket, 2m + 3n, shares no further factor, so the expression is completely factorised."
    }
  ],

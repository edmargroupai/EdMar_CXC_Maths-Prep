  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 8x³y² − 12x²y³ + 4x²y²."
    },
    {
      "type": "text",
      "value": "Think first: Three terms, but the method is unchanged: find what all three share."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q13.jpg",
      "altText": "Source visual for edmar-csec-p066-q13 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8, 12 and 4 are all divisible by 4"
        },
        {
          "type": "text",
          "value": "Result: 4"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find the lowest power of each letter.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x³, x², x² give x²; y², y³, y² give y²"
        },
        {
          "type": "text",
          "value": "Result: x²y²"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Combine into the full HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4 × x² × y²"
        },
        {
          "type": "text",
          "value": "Result: 4x²y²"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide each term by 4x²y².",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8x³y² ÷ 4x²y² = 2x, 12x²y³ ÷ 4x²y² = 3y, 4x²y² ÷ 4x²y² = 1"
        },
        {
          "type": "text",
          "value": "Result: 2x, 3y and 1"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 4x²y²(2x − 3y + 1)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Take the HCF of 8, 12 and 4 together with the lowest power of x and of y across all three terms, then divide each term by it."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "8x³y² − 12x²y³ + 4x²y² = 4x²y²(2x − 3y + 1)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The highest common factor must divide every term, so with three terms each letter is taken to the smallest index that occurs anywhere in the expression. The last term is exactly equal to the factor being removed, so it leaves 1 rather than nothing. Expanding 4x²y²(2x − 3y + 1) reproduces all three original terms, which confirms the result."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "A dress costing $6 500 is reduced by 18%. Calculate the sale price."
    },
    {
      "type": "text",
      "value": "Think first: A reduction of 18% means you still pay 82% of the original price, so one multiplication gets you there."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p019_q13.jpg",
      "altText": "Source visual for edmar-csec-p019-q13 from workbook page 19."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Work out the percentage of the price still paid.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "100% - 18%"
        },
        {
          "type": "text",
          "value": "Result: 82%"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Change 82% to a decimal multiplier.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "82 / 100"
        },
        {
          "type": "text",
          "value": "Result: 0.82"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Multiply the original price by the multiplier.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "$6 500 x 0.82"
        },
        {
          "type": "text",
          "value": "Result: $5 330"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by finding the discount separately.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "18% of $6 500 = $1 170, then $6 500 - $1 170"
        },
        {
          "type": "text",
          "value": "Result: $5 330"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find the percentage of the price that remains after the discount (100% - 18% = 82%) and take that percentage of $6 500."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "The sale price is $5 330."
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A percentage decrease keeps the original price as the 100% base. Subtracting the discount percentage from 100% gives the fraction of the original that survives, so a single multiplication replaces two steps. Both routes agree because $6 500 x 0.82 and $6 500 - $6 500 x 0.18 are the same expression written differently."
    }
  ],

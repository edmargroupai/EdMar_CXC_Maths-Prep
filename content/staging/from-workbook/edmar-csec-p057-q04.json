  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute a = 5 and b = 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2(5) - 3"
        },
        {
          "type": "text",
          "value": "Result: 10 - 3"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Subtract.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 7"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute a = 5 and b = 3 into 2a - b."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "5 * 3 = 7"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Position matters in this operation: the left input is doubled and the right one is taken away, so 5 * 3 and 3 * 5 are different. Reading the definition carefully and matching each letter to its position is the whole of the work."
    }
  ],

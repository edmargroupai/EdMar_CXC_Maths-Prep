  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the inequality x/3 ≥ 4."
    },
    {
      "type": "text",
      "value": "Think first: x has been divided by 3, so multiply both sides by 3 to free it."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p059_q05.jpg",
      "altText": "Source visual for edmar-csec-p059-q05 from workbook page 59."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply both sides by 3 to clear the denominator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 × x/3 = x, and 3 × 4 = 12"
        },
        {
          "type": "text",
          "value": "Result: x ≥ 12"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Check the boundary value in the original inequality.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x = 12 gives 12/3 = 4, and 4 ≥ 4 is true"
        },
        {
          "type": "text",
          "value": "Result: x ≥ 12 confirmed"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply both sides by 3."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x ≥ 12"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Multiplying by 3 undoes the division by 3, and because 3 is positive the ≥ sign stays as it is. Every number from 12 upwards works: x = 12 gives 4 ≥ 4, which is true, and anything larger gives a value greater than 4."
    }
  ],

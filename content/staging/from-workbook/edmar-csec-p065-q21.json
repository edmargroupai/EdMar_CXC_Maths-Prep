  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify (7x⁴ × 2x³) / (21x²)."
    },
    {
      "type": "text",
      "value": "Think first: The coefficients will not divide exactly, so expect a fraction in the answer."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p065_q21.jpg",
      "altText": "Source visual for edmar-csec-p065-q21 from workbook page 65."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the coefficients in the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7 × 2 = 14"
        },
        {
          "type": "text",
          "value": "Result: 14"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add the indices in the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x⁴ × x³ = x^(4+3)"
        },
        {
          "type": "text",
          "value": "Result: 14x⁷"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Simplify the number fraction.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "14/21, dividing both by 7"
        },
        {
          "type": "text",
          "value": "Result: 2/3"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Subtract the indices.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x⁷ ÷ x² = x^(7−2)"
        },
        {
          "type": "text",
          "value": "Result: (2/3)x⁵"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Combine the numerator, then simplify the numerical fraction and subtract the indices."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(7x⁴ × 2x³) / (21x²) = (2/3)x⁵, which may also be written 2x⁵/3"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The expression is a single fraction, so it can be split into a number part and an x part that are simplified independently. A coefficient fraction that does not reduce to a whole number is perfectly acceptable as a final answer, provided it is in lowest terms. Reducing 14/21 by their highest common factor of 7 is what puts it there."
    }
  ],

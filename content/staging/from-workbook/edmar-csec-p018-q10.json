  "stemBlocks": [
    {
      "type": "text",
      "value": "$15 000 is invested at 4% per annum compound interest for 3 years. Calculate the total interest earned."
    },
    {
      "type": "text",
      "value": "Think first: Interest is the finishing amount minus the starting amount, so find the amount first."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p018_q10.jpg",
      "altText": "Source visual for edmar-csec-p018-q10 from workbook page 18."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the rate as a multiplier.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4% increase means × 1.04"
        },
        {
          "type": "text",
          "value": "Result: × 1.04"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Raise it to the number of years.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "1.04³ = 1.04 × 1.04 × 1.04"
        },
        {
          "type": "text",
          "value": "Result: 1.124864"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Find the amount after 3 years.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "15000 × 1.124864"
        },
        {
          "type": "text",
          "value": "Result: $16 872.96"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Subtract the principal.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "16872.96 − 15000"
        },
        {
          "type": "text",
          "value": "Result: $1872.96"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply $15 000 by 1.04³ to get the amount, then subtract the original $15 000."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "$1 872.96"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Each year multiplies the balance by 1.04, so three years multiply it by 1.04³. The interest cannot be found by taking 4% of the principal three times, because from year two onwards the 4% is applied to a larger balance; simple interest would give only $1 800, and the extra $72.96 is the interest earned on earlier interest."
    }
  ],

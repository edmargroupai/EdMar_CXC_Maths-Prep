  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 2x + y = 7 and x − y = 1."
    },
    {
      "type": "text",
      "value": "Think first: The y terms are +y and −y, so add the equations straight away — and do not be alarmed if the answers are fractions."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p097_q04.jpg",
      "altText": "Source visual for edmar-csec-p097-q04 from workbook page 97."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Add the two equations.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(2x + x) + (y − y) = 7 + 1"
        },
        {
          "type": "text",
          "value": "Result: 3x = 8"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x, leaving the answer as a fraction.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8 ÷ 3"
        },
        {
          "type": "text",
          "value": "Result: x = 8/3"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute into x − y = 1.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8/3 − y = 1, so y = 8/3 − 1 = 8/3 − 3/3"
        },
        {
          "type": "text",
          "value": "Result: y = 5/3"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2(8/3) + 5/3 = 16/3 + 5/3 = 21/3"
        },
        {
          "type": "text",
          "value": "Result: 7 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Add the equations to eliminate y, solve for x as a fraction, then substitute back."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 8/3, y = 5/3 (that is, x = 2 2/3 and y = 1 2/3)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The two lines still cross at exactly one point; there is simply no reason for that crossing point to have whole-number coordinates. Elimination locates it just as reliably, and keeping the values as exact fractions avoids the rounding errors that decimals would introduce."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations x + 2y = 8 and x² + y² = 20."
    },
    {
      "type": "text",
      "value": "Think first: Make x the subject of the linear equation — it has no coefficient — and substitute into the quadratic."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p113_q13.jpg",
      "altText": "Source visual for edmar-csec-p113-q13 from workbook page 113."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Make x the subject of the linear equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x + 2y = 8"
        },
        {
          "type": "text",
          "value": "Result: x = 8 − 2y"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute into x² + y² = 20.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(8 − 2y)² + y² = 20"
        },
        {
          "type": "text",
          "value": "Result: 64 − 32y + 4y² + y² = 20"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Collect terms into standard form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5y² − 32y + 64 − 20 = 0"
        },
        {
          "type": "text",
          "value": "Result: 5y² − 32y + 44 = 0"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Solve the quadratic.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Discriminant = (−32)² − 4(5)(44) = 1024 − 880 = 144, √144 = 12, so y = (32 ± 12)/10"
        },
        {
          "type": "text",
          "value": "Result: y = 2 or y = 4.4"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Find the matching x from x = 8 − 2y.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y = 2 → x = 4;  y = 4.4 → x = 8 − 8.8 = −0.8"
        },
        {
          "type": "text",
          "value": "Result: (4, 2) and (−0.8, 4.4)"
        }
      ]
    },
    {
      "stepNo": 6,
      "instruction": "Check in x² + y² = 20.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4² + 2² = 20;  (−0.8)² + (4.4)² = 0.64 + 19.36 = 20"
        },
        {
          "type": "text",
          "value": "Result: Both pairs verified"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Rearrange to x = 8 − 2y, substitute into x² + y² = 20, solve the quadratic 5y² − 32y + 44 = 0, then find each matching x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 4, y = 2  or  x = −0.8, y = 4.4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The linear equation is a straight line and x² + y² = 20 is a circle centred at the origin, so the two solutions are the two points where the line cuts the circle. Substitution reduces the pair to one quadratic in y; the discriminant being a perfect square is what makes the roots exact decimals rather than surds."
    }
  ],

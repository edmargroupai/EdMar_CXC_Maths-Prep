  "stemBlocks": [
    {
      "type": "text",
      "value": "Given x = 2, y = −5 and z = 3, find: (a) x − 2y  (b) xz²."
    },
    {
      "type": "text",
      "value": "Think first: Substitute with brackets around every negative value so the signs look after themselves."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p061_q02.jpg",
      "altText": "Source visual for edmar-csec-p061-q02 from workbook page 61."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute into x − 2y.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 − 2(−5)"
        },
        {
          "type": "text",
          "value": "Result: 2 + 10"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Simplify part (a).",
      "contentBlocks": [
        {
          "type": "text",
          "value": "subtracting a negative gives an addition"
        },
        {
          "type": "text",
          "value": "Result: 12"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute into xz².",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × 3², and 3² = 9"
        },
        {
          "type": "text",
          "value": "Result: 2 × 9"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Simplify part (b).",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 18"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Replace each letter by its value, using brackets for the negative, and evaluate part by part."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(a) 12  (b) 18"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Writing 2(−5) inside brackets makes it clear that the whole product −10 is being subtracted, so the two minus signs combine into a plus. In part (b) the index attaches only to z, not to the product xz, so z is squared first and then multiplied by x."
    }
  ],

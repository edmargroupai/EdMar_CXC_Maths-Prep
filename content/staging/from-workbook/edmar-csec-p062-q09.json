  "stemBlocks": [
    {
      "type": "text",
      "value": "If y = −4, evaluate y² + 3y − 7."
    },
    {
      "type": "text",
      "value": "Think first: Squaring a negative gives a positive, but the middle term stays negative - keep the two separate."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p062_q09.jpg",
      "altText": "Source visual for edmar-csec-p062-q09 from workbook page 62."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute y = −4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−4)² + 3(−4) − 7"
        },
        {
          "type": "text",
          "value": "Result: 16 + (−12) − 7"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Simplify the middle term.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "adding −12 is subtracting 12"
        },
        {
          "type": "text",
          "value": "Result: 16 − 12 − 7"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Combine left to right.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "16 − 12 = 4, then 4 − 7"
        },
        {
          "type": "text",
          "value": "Result: −3"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute y = −4 in brackets, evaluate each term, then combine left to right."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "−3"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "(−4)² means (−4) × (−4), which is +16, whereas 3y keeps the sign of y and gives −12. Bracketing the substituted value is what separates these two behaviours; without brackets the squared term is easily written as −16."
    }
  ],

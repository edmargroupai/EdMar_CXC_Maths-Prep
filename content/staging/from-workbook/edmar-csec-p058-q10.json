  "stemBlocks": [
    {
      "type": "text",
      "value": "A binary operation * is defined by a * b = √(a² + b²). Find 3 * 4."
    },
    {
      "type": "text",
      "value": "Think first: Square each input, add the results, and only then take the square root."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p058_q10.jpg",
      "altText": "Source visual for edmar-csec-p058-q10 from workbook page 58."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute a = 3 and b = 4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3² + 4² = 9 + 16"
        },
        {
          "type": "text",
          "value": "Result: √25"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Take the square root.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 5"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute a = 3 and b = 4, evaluate inside the root first, then take the square root."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "3 * 4 = 5"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Everything under the root sign must be worked out before the root is taken - the root acts as a bracket. This particular rule is Pythagoras' theorem in disguise, which is why the familiar 3, 4, 5 △ appears and the answer is a whole number."
    }
  ],

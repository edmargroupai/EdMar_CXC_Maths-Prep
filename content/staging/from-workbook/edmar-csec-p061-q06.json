  "stemBlocks": [
    {
      "type": "text",
      "value": "If a = 4, b = −2 and c = 3, find (a² − bc)/(b + c)."
    },
    {
      "type": "text",
      "value": "Think first: Evaluate the top and the bottom completely and separately before you divide."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p061_q06.jpg",
      "altText": "Source visual for edmar-csec-p061-q06 from workbook page 61."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Evaluate a².",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4²"
        },
        {
          "type": "text",
          "value": "Result: 16"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Evaluate bc and subtract it.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−2)(3) = −6, so 16 − (−6) = 16 + 6"
        },
        {
          "type": "text",
          "value": "Result: numerator = 22"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Evaluate the denominator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2 + 3"
        },
        {
          "type": "text",
          "value": "Result: denominator = 1"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "22 ÷ 1"
        },
        {
          "type": "text",
          "value": "Result: 22"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Work out the numerator a² − bc, then the denominator b + c, then divide one by the other."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "22"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A fraction bar acts as a bracket around both the top and the bottom, so each must be fully simplified before dividing. The key sign move is 16 − (−6): subtracting a negative product adds, which turns what looks like a subtraction into an increase."
    }
  ],

  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply both sides by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2A = 2 × (1/2)bh"
        },
        {
          "type": "text",
          "value": "Result: 2A = bh"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide both sides by b.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2A/b = bh/b"
        },
        {
          "type": "text",
          "value": "Result: h = 2A/b"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply both sides by 2 to remove the half, then divide by b."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "h = 2A/b"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Multiplying by 2 is the inverse of taking a half, and dividing by b is the inverse of multiplying by b. The rearranged formula is genuinely useful: given the area of a △ and its base, it hands you the perpendicular height in one step."
    }
  ],

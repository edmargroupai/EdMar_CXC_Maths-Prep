  "stemBlocks": [
    {
      "type": "text",
      "value": "A television costs $95 000 plus VAT at 15%. a. Calculate the VAT.  b. Calculate the total cost including VAT."
    },
    {
      "type": "text",
      "value": "Think first: VAT is added on top of the marked price, so the $95 000 is the pre-tax figure, not the total."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p018_q12.jpg",
      "altText": "Source visual for edmar-csec-p018-q12 from workbook page 18."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find 10% of the price as a stepping stone.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "95000 ÷ 10"
        },
        {
          "type": "text",
          "value": "Result: $9 500"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find 5%, which is half of 10%.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9500 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: $4 750"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Add them to get 15%.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9500 + 4750"
        },
        {
          "type": "text",
          "value": "Result: $14 250 VAT"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Add the VAT to the marked price.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "95000 + 14250"
        },
        {
          "type": "text",
          "value": "Result: $109 250"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find 15% of $95 000 for the VAT, then add it to the marked price."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "a. $14 250  b. $109 250"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "VAT is a percentage increase applied to the pre-tax price, so the tax is 15% of $95 000 and the total is 115% of it. Building 15% from 10% and 5% works because percentages of the same quantity add, which makes the whole calculation possible without a calculator. The multiplier confirms it: 95 000 × 1.15 = 109 250."
    }
  ],

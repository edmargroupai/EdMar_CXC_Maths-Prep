  "stemBlocks": [
    {
      "type": "text",
      "value": "A loan of $12 000 was taken at 10% per annum simple interest for 18 months. a. Calculate the interest payable.  b. Calculate the total amount to be repaid."
    },
    {
      "type": "text",
      "value": "Think first: The rate is per annum but the time is in months, so convert the time to years before substituting."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p016_q03.jpg",
      "altText": "Source visual for edmar-csec-p016-q03 from workbook page 16."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Convert the time to years.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "18 ÷ 12"
        },
        {
          "type": "text",
          "value": "Result: 1.5 years"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute into the formula.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "I = (12000 × 10 × 1.5)/100"
        },
        {
          "type": "text",
          "value": "Result: I = 1200 × 1.5"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Calculate the interest.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "1200 × 1.5"
        },
        {
          "type": "text",
          "value": "Result: $1800"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Add the interest to the principal.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "12000 + 1800"
        },
        {
          "type": "text",
          "value": "Result: $13 800"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Change 18 months into 1.5 years, apply I = PRT/100, then add the interest to the loan."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "a. $1 800  b. $13 800"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A rate quoted per annum measures interest per year, so T in the formula must also be counted in years or the two quantities do not match. Converting 18 months to 1.5 years keeps the units consistent, and because simple interest is proportional to time, half a year simply earns half a year's interest. The repayment is the borrowed sum plus that charge."
    }
  ],

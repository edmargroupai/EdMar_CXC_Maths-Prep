  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify (7x − 2)/5 + (x − 5)/6 as a single fraction."
    },
    {
      "type": "text",
      "value": "Think first: Both denominators are numbers with no common factor, so the LCD is simply their product."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p051_q12.jpg",
      "altText": "Source visual for edmar-csec-p051-q12 from workbook page 51."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the lowest common denominator of 5 and 6.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5 and 6 share no factor, so LCM = 5 × 6"
        },
        {
          "type": "text",
          "value": "Result: 30"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Rewrite each fraction over 30.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(7x − 2) is multiplied by 6; (x − 5) is multiplied by 5"
        },
        {
          "type": "text",
          "value": "Result: [6(7x − 2) + 5(x − 5)]/30"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Expand the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "42x − 12 and 5x − 25"
        },
        {
          "type": "text",
          "value": "Result: 42x − 12 + 5x − 25"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Collect like terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "42x + 5x = 47x and −12 − 25 = −37"
        },
        {
          "type": "text",
          "value": "Result: 47x − 37"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Use 30 as the common denominator, multiply each numerator by the matching factor, then collect like terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(47x − 37)/30"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The multiplier attached to each numerator is exactly the denominator the other fraction contributed, which is what makes both fractions land on 30 without changing value. Adding then works on numerators alone. The final fraction cannot be reduced because 47 is prime and 37 shares no factor with 30."
    }
  ],

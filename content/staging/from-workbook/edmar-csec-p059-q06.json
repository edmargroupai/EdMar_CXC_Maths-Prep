  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the inequality 9 − x < 3x."
    },
    {
      "type": "text",
      "value": "Think first: Move the −x across to the right so you never have to divide by a negative."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p059_q06.jpg",
      "altText": "Source visual for edmar-csec-p059-q06 from workbook page 59."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Add x to both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9 < 3x + x"
        },
        {
          "type": "text",
          "value": "Result: 9 < 4x"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide both sides by 4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9/4 < x"
        },
        {
          "type": "text",
          "value": "Result: x > 9/4"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Write as a decimal.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9 ÷ 4"
        },
        {
          "type": "text",
          "value": "Result: x > 2.25"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Add x to both sides to collect the x terms on the right, then divide by 4."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x > 9/4, that is x > 2.25"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Adding x to both sides keeps the inequality direction and leaves a positive coefficient, which removes any risk of a sign error. When the unknown ends up on the right, as in 9 < 4x, reading the statement backwards gives x > 9/4 - the sign turns to face the same quantity it faced before."
    }
  ],

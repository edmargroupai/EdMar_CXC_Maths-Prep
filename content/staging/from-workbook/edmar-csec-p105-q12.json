  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the quadratic equation x² − 3x − 1 = 0."
    },
    {
      "type": "text",
      "value": "Think first: No whole numbers multiply to −1 and add to −3, so reach for the quadratic formula."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p105_q12.jpg",
      "altText": "Source visual for edmar-csec-p105-q12 from workbook page 105."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write down a, b and c.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "comparing with ax² + bx + c = 0"
        },
        {
          "type": "text",
          "value": "Result: a = 1, b = −3, c = −1"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Evaluate the discriminant.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−3)² − 4(1)(−1) = 9 + 4"
        },
        {
          "type": "text",
          "value": "Result: 13"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute into the formula.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x = (3 ± √13) / 2"
        },
        {
          "type": "text",
          "value": "Result: x = (3 ± √13) / 2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Evaluate both roots to two decimal places.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "√13 ≈ 3.6056, so (3 + 3.6056)/2 and (3 − 3.6056)/2"
        },
        {
          "type": "text",
          "value": "Result: x ≈ 3.30 or x ≈ −0.30"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Identify a, b and c, substitute into the quadratic formula, and evaluate exactly and then to 2 decimal places."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = (3 + √13)/2 ≈ 3.30 or x = (3 − √13)/2 ≈ −0.30 (2 d.p.)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The discriminant is 13, positive but not a perfect square, so the equation has two real irrational roots and cannot factorise over the integers. The formula delivers them directly. Note that −b becomes +3 because b itself is negative — that sign handling is where the formula most often goes wrong."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: (3x + 2)² − 49"
    },
    {
      "type": "text",
      "value": "Think first: A whole bracket can play the part of 'a' in a² − b², so there is no need to expand anything."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p093_q11.jpg",
      "altText": "Source visual for edmar-csec-p093-q11 from workbook page 93."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write both terms as squares.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(3x + 2)² is already a square and 49 = 7²"
        },
        {
          "type": "text",
          "value": "Result: (3x + 2)² − 7²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Apply the difference of two squares.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Here a = 3x + 2 and b = 7"
        },
        {
          "type": "text",
          "value": "Result: (3x + 2 − 7)(3x + 2 + 7)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Simplify inside each bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3x + 2 − 7 = 3x − 5 and 3x + 2 + 7 = 3x + 9"
        },
        {
          "type": "text",
          "value": "Result: (3x − 5)(3x + 9)"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Take the common factor out of the second bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3x + 9 = 3(x + 3)"
        },
        {
          "type": "text",
          "value": "Result: 3(3x − 5)(x + 3)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Treat 3x + 2 as a single quantity, apply the difference of two squares, simplify each bracket, then remove any remaining common factor."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "3(3x − 5)(x + 3), which is (3x − 5)(3x + 9) fully factorised."
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The rule a² − b² = (a − b)(a + b) does not care whether a is a single letter or a whole expression, so a squared bracket can be treated exactly like x². The word 'completely' then demands one more step: the factor 3 inside the second bracket must also come out."
    }
  ],

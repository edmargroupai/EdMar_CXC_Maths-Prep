  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 3x + y = 10 and x − y = 2."
    },
    {
      "type": "text",
      "value": "Think first: The y terms are opposites, so one addition clears them."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p098_q07.jpg",
      "altText": "Source visual for edmar-csec-p098-q07 from workbook page 98."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Add the two equations.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(3x + x) + (y − y) = 10 + 2"
        },
        {
          "type": "text",
          "value": "Result: 4x = 12"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "12 ÷ 4"
        },
        {
          "type": "text",
          "value": "Result: x = 3"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute x = 3 into x − y = 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 − y = 2"
        },
        {
          "type": "text",
          "value": "Result: y = 1"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(3) + 1 = 9 + 1"
        },
        {
          "type": "text",
          "value": "Result: 10 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Add the equations to eliminate y, find x, then substitute to find y."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 3, y = 1"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Each equation restricts the possible pairs (x, y) to a line; only one pair lies on both lines. Elimination finds it by combining the equations into one that mentions a single unknown, so no guessing is involved."
    }
  ],

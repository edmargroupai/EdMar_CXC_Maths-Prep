  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the equation 5x − 1 = 8x + 1."
    },
    {
      "type": "text",
      "value": "Think first: The unknown appears on both sides, so the first job is to gather all the x-terms together."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p054_q01.jpg",
      "altText": "Source visual for edmar-csec-p054-q01 from workbook page 54."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract 5x from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5x − 5x = 0 and 8x − 5x = 3x"
        },
        {
          "type": "text",
          "value": "Result: −1 = 3x + 1"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Subtract 1 from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−1 − 1 = −2"
        },
        {
          "type": "text",
          "value": "Result: −2 = 3x"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide both sides by 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2 ÷ 3"
        },
        {
          "type": "text",
          "value": "Result: x = −2/3"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by substitution.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "LHS: 5(−2/3) − 1 = −13/3; RHS: 8(−2/3) + 1 = −13/3"
        },
        {
          "type": "text",
          "value": "Result: both sides equal −13/3"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Move the x-terms to one side and the numbers to the other, then divide by the coefficient of x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = −2/3"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "An equation is a statement that two expressions have equal value, and that equality survives any operation applied identically to both sides. Subtracting 5x from each side removes x from the left without disturbing the balance, leaving a single x-term to isolate. The solution is a fraction simply because 3 does not divide −2 exactly, which is perfectly acceptable."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "A binary operation * is defined by a * b = a² + b². Find x * x."
    },
    {
      "type": "text",
      "value": "Think first: Both inputs are the same letter, so substitute x for a and for b and then simplify."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p057_q07.jpg",
      "altText": "Source visual for edmar-csec-p057-q07 from workbook page 57."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute a = x and b = x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² + x²"
        },
        {
          "type": "text",
          "value": "Result: x² + x²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Collect like terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "one lot of x² plus one lot of x²"
        },
        {
          "type": "text",
          "value": "Result: 2x²"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Replace a with x and b with x in a² + b², then collect the like terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x * x = 2x²"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A binary operation works on any inputs, not just numbers, so substituting a letter is no different from substituting a number. Because x² + x² is two identical terms, they add to 2x² - the coefficient doubles while the index stays the same."
    }
  ],

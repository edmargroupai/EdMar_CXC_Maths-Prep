  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 5x + 4y = 6 and 3x − 4y = 10."
    },
    {
      "type": "text",
      "value": "Think first: The y terms are already +4y and −4y, so adding the equations wipes y out immediately."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p097_q02.jpg",
      "altText": "Source visual for edmar-csec-p097-q02 from workbook page 97."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Add the two equations term by term.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(5x + 3x) + (4y − 4y) = 6 + 10"
        },
        {
          "type": "text",
          "value": "Result: 8x = 16"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "16 ÷ 8"
        },
        {
          "type": "text",
          "value": "Result: x = 2"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute x = 2 into the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5(2) + 4y = 6, so 10 + 4y = 6"
        },
        {
          "type": "text",
          "value": "Result: 4y = −4"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide to find y.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−4 ÷ 4"
        },
        {
          "type": "text",
          "value": "Result: y = −1"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check in the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(2) − 4(−1) = 6 + 4"
        },
        {
          "type": "text",
          "value": "Result: 10 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Add the two equations as they stand to eliminate y, solve for x, then substitute to find y."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 2, y = −1"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "When the coefficients of one unknown are equal in size but opposite in sign, adding the equations makes that unknown vanish without any preparation. What remains is a single equation in one unknown, and back-substitution recovers the other."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "If x = 5, evaluate 2x² − 3x + 1."
    },
    {
      "type": "text",
      "value": "Think first: The index applies only to x, so square 5 before multiplying by 2."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p062_q08.jpg",
      "altText": "Source visual for edmar-csec-p062-q08 from workbook page 62."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute x = 5.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2(5²) − 3(5) + 1"
        },
        {
          "type": "text",
          "value": "Result: 2(25) − 15 + 1"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply out the terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × 25 = 50"
        },
        {
          "type": "text",
          "value": "Result: 50 − 15 + 1"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Combine.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "50 − 15 = 35, then 35 + 1"
        },
        {
          "type": "text",
          "value": "Result: 36"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute x = 5, square first, then multiply, then combine the terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "36"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "In 2x² the square belongs to x alone, so 5 is squared to 25 and only then doubled. Working left to right through 50 − 15 + 1 keeps the addition and subtraction in the right order, which matters whenever the signs alternate."
    }
  ],

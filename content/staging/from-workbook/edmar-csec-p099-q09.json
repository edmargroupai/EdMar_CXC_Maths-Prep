  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 4m + 5n = −7 and 3m − 2n = 12."
    },
    {
      "type": "text",
      "value": "Think first: Neither coefficient matches, so scale both equations until one unknown has the same size coefficient in each."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p099_q09.jpg",
      "altText": "Source visual for edmar-csec-p099-q09 from workbook page 99."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the first equation by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × (4m + 5n = −7)"
        },
        {
          "type": "text",
          "value": "Result: 8m + 10n = −14"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply the second equation by 5.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5 × (3m − 2n = 12)"
        },
        {
          "type": "text",
          "value": "Result: 15m − 10n = 60"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Add the two new equations so the n terms cancel.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(8m + 15m) + (10n − 10n) = −14 + 60"
        },
        {
          "type": "text",
          "value": "Result: 23m = 46"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide to find m.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "46 ÷ 23"
        },
        {
          "type": "text",
          "value": "Result: m = 2"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Substitute m = 2 into the first original equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4(2) + 5n = −7, so 5n = −15"
        },
        {
          "type": "text",
          "value": "Result: n = −3"
        }
      ]
    },
    {
      "stepNo": 6,
      "instruction": "Check in the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(2) − 2(−3) = 6 + 6"
        },
        {
          "type": "text",
          "value": "Result: 12 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply the first equation by 2 and the second by 5 to make the n terms +10n and −10n, then add."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "m = 2, n = −3"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Multiplying an equation through by a constant produces a different-looking equation with exactly the same solutions, so scaling is always safe. Choosing multipliers that make one pair of coefficients equal in size and opposite in sign turns addition into a clean elimination."
    }
  ],

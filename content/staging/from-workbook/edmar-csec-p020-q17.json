  "stemBlocks": [
    {
      "type": "text",
      "value": "A laptop was sold for $72 000 at a 10% loss. Calculate the original cost price."
    },
    {
      "type": "text",
      "value": "Think first: The $72 000 is not the base here; it is what is left after 10% of the unknown cost price has been lost."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p020_q17.jpg",
      "altText": "Source visual for edmar-csec-p020-q17 from workbook page 20."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "State the selling price as a percentage of the cost price.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "100% - 10%"
        },
        {
          "type": "text",
          "value": "Result: 90% of cost price"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Write the equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "0.90 x cost price = $72 000"
        },
        {
          "type": "text",
          "value": "Result: cost price = 72 000 / 0.90"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "72 000 / 0.9"
        },
        {
          "type": "text",
          "value": "Result: $80 000"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check the loss.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "10% of $80 000 = $8 000, and $80 000 - $8 000"
        },
        {
          "type": "text",
          "value": "Result: $72 000"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Treat the cost price as 100%. A 10% loss means the selling price is 90% of the cost price, so divide $72 000 by 0.90."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "The original cost price was $80 000."
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "In a reverse percentage the known amount is a part, not the whole, so you divide rather than multiply. Adding 10% of $72 000 gives $79 200, which is wrong because the 10% was lost from the larger cost price, not from the smaller selling price. Setting the unknown as 100% keeps the base straight."
    }
  ],

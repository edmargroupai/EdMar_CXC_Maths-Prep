    {
      "type": "text",
      "value": "Factorise completely: 12a³ − 18a² + 14ab − 21b"
    },
    {
      "type": "text",
      "value": "Think first: The highest common factor of the first pair involves a², not just a."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p092_q06.jpg",
      "altText": "Source visual for edmar-csec-p092-q06 from workbook page 92."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Group the terms in pairs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(12a³ − 18a²) + (14ab − 21b)"
        },
        {
          "type": "text",
          "value": "Result: Two pairs"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Take the highest common factor out of each pair.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6a² from 12a³ − 18a², and 7b from 14ab − 21b"
        },
        {
          "type": "text",
          "value": "Result: 6a²(2a − 3) + 7b(2a − 3)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Take out the common bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(2a − 3) appears in both terms"
        },
        {
          "type": "text",
          "value": "Result: (2a − 3)(6a² + 7b)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Take 6a² out of the first pair and 7b out of the second, then take out the bracket they share."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(2a − 3)(6a² + 7b)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Taking the highest common factor out of each pair is what forces the same bracket to appear twice; taking out less than the highest, such as 6a instead of 6a², leaves brackets that do not match. The shared bracket then lifts out as a single factor."
    }
  ],

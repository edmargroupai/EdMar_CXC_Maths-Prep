  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 9a² − 6ab + 12a − 8b"
    },
    {
      "type": "text",
      "value": "Think first: Look for the pairing that leaves the same bracket twice."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p092_q04.jpg",
      "altText": "Source visual for edmar-csec-p092-q04 from workbook page 92."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Group the terms in pairs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(9a² − 6ab) + (12a − 8b)"
        },
        {
          "type": "text",
          "value": "Result: Two pairs"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Take the common factor out of each pair.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3a from 9a² − 6ab, and 4 from 12a − 8b"
        },
        {
          "type": "text",
          "value": "Result: 3a(3a − 2b) + 4(3a − 2b)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Take out the common bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(3a − 2b) appears in both terms"
        },
        {
          "type": "text",
          "value": "Result: (3a − 2b)(3a + 4)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Group the first two and the last two terms, take out 3a and then 4, and finish by taking out the shared bracket."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(3a − 2b)(3a + 4)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Grouping works because factorising each pair reveals the same bracket in both terms, and that bracket can then be taken out exactly like a common number or letter. Expanding the answer returns the four original terms, which is the check."
    }
  ],

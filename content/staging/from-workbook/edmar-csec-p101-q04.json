  "stemBlocks": [
    {
      "type": "text",
      "value": "Express x² − 2x + 11 in the form (x + h)² + k by completing the square."
    },
    {
      "type": "text",
      "value": "Think first: Half of −2 is −1, and the small correction here leaves k positive."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p101_q04.jpg",
      "altText": "Source visual for edmar-csec-p101-q04 from workbook page 101."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Halve the coefficient of x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: −1, so the bracket is (x − 1)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Expand to see the surplus.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x − 1)² = x² − 2x + 1"
        },
        {
          "type": "text",
          "value": "Result: 1 too many"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract 1 and add the original constant 11.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² − 2x + 11 = (x − 1)² − 1 + 11"
        },
        {
          "type": "text",
          "value": "Result: (x − 1)² + 10"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² − 2x + 1 + 10"
        },
        {
          "type": "text",
          "value": "Result: x² − 2x + 11 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Form (x − 1)², subtract the 1 it introduces and add the original constant 11."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x² − 2x + 11 = (x − 1)² + 10"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Because a square is never negative, (x − 1)² + 10 can never fall below 10, so the completed square form shows at a glance that this expression has a minimum value of 10 at x = 1 and never reaches zero. That is information the original form hides."
    }
  ],

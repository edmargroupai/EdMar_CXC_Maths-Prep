  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the quadratic equation x² − 5x + 6 = 0."
    },
    {
      "type": "text",
      "value": "Think first: Look for two numbers that multiply to 6 and add to −5 — this one factorises neatly."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p104_q01.jpg",
      "altText": "Source visual for edmar-csec-p104-q01 from workbook page 104."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find two numbers whose product is +6 and whose sum is −5.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2 × −3 = 6 and −2 + (−3) = −5"
        },
        {
          "type": "text",
          "value": "Result: −2 and −3"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Write the expression as a product of two brackets.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² − 5x + 6 = (x − 2)(x − 3)"
        },
        {
          "type": "text",
          "value": "Result: (x − 2)(x − 3) = 0"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Set each bracket equal to zero and solve.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x − 2 = 0 or x − 3 = 0"
        },
        {
          "type": "text",
          "value": "Result: x = 2 or x = 3"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Factorise the left-hand side into two brackets, then set each bracket equal to zero."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 2 or x = 3"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "If a product of two quantities is zero then at least one of them must be zero — that is the zero product property, and it is what turns a factorised quadratic into two simple linear equations. Factorising is just the reverse of expanding, so checking is easy: (x − 2)(x − 3) expands back to x² − 5x + 6. Substituting either root into the original equation gives 0."
    }
  ],

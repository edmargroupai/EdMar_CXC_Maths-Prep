  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations (x − 1)/3 + (y + 2)/2 = 5 and x − y = 3."
    },
    {
      "type": "text",
      "value": "Think first: Clear the fractions in the first equation before combining it with the second."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p099_q11.jpg",
      "altText": "Source visual for edmar-csec-p099-q11 from workbook page 99."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply every term of the first equation by 6.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6 × (x − 1)/3 + 6 × (y + 2)/2 = 6 × 5"
        },
        {
          "type": "text",
          "value": "Result: 2(x − 1) + 3(y + 2) = 30"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Expand and simplify.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x − 2 + 3y + 6 = 30"
        },
        {
          "type": "text",
          "value": "Result: 2x + 3y = 26"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Make x the subject of the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x − y = 3"
        },
        {
          "type": "text",
          "value": "Result: x = y + 3"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Substitute into 2x + 3y = 26.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2(y + 3) + 3y = 26, so 5y + 6 = 26"
        },
        {
          "type": "text",
          "value": "Result: 5y = 20, y = 4"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x = 4 + 3"
        },
        {
          "type": "text",
          "value": "Result: x = 7"
        }
      ]
    },
    {
      "stepNo": 6,
      "instruction": "Check in the original fractional equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(7 − 1)/3 + (4 + 2)/2 = 2 + 3"
        },
        {
          "type": "text",
          "value": "Result: 5 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply the first equation by 6, the LCM of 3 and 2, simplify it to a standard linear equation, then substitute using x = y + 3."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 7, y = 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Multiplying by the lowest common multiple of the denominators removes every fraction in one move while keeping the equation equivalent, because both sides are scaled by the same factor. What is left is an ordinary pair of linear equations that standard substitution solves."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "If l = −2, m = 3 and n = 7, find lm(m − n)."
    },
    {
      "type": "text",
      "value": "Think first: Work out the bracket first, then multiply the three factors, tracking the signs as you go."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p061_q04.jpg",
      "altText": "Source visual for edmar-csec-p061-q04 from workbook page 61."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute the values.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "l = −2, m = 3, n = 7"
        },
        {
          "type": "text",
          "value": "Result: (−2)(3)(3 − 7)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Evaluate the bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 − 7"
        },
        {
          "type": "text",
          "value": "Result: −4"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Multiply lm.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−2)(3)"
        },
        {
          "type": "text",
          "value": "Result: −6"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Multiply the two results.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−6)(−4), and a negative times a negative is positive"
        },
        {
          "type": "text",
          "value": "Result: 24"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute the values, evaluate the bracket, then multiply lm by the bracket's value."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "24"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Brackets come before multiplication, so m − n must be found before anything is multiplied by it. Two negative factors appear in the final product - the −6 and the −4 - and a pair of negatives multiplies to a positive, which is why the answer is +24."
    }
  ],

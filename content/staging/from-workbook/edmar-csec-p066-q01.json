  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 2x + 6."
    },
    {
      "type": "text",
      "value": "Think first: Look for the largest number that divides into both terms."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q01.jpg",
      "altText": "Source visual for edmar-csec-p066-q01 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the two terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x = 2 × x and 6 = 2 × 3"
        },
        {
          "type": "text",
          "value": "Result: HCF = 2"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide each term by the HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x ÷ 2 = x and 6 ÷ 2 = 3"
        },
        {
          "type": "text",
          "value": "Result: x and 3"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Write the HCF outside a bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 2(x + 3)"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × x + 2 × 3"
        },
        {
          "type": "text",
          "value": "Result: 2x + 6"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find the HCF of 2x and 6, take it outside a bracket, and write what is left inside."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "2x + 6 = 2(x + 3)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Factorising is the reverse of expanding. Every term shares a highest common factor, and pulling it outside a bracket leaves behind exactly what each term must be multiplied by to get back to the original. Because multiplication distributes over addition, expanding the bracket returns the expression you started with, which is the check that the factorisation is correct."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "If a = 3, find the value of a³ − 4a."
    },
    {
      "type": "text",
      "value": "Think first: A cube means three equal factors, not multiplying by three."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p062_q12.jpg",
      "altText": "Source visual for edmar-csec-p062-q12 from workbook page 62."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the expression with 3 in place of a.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "a³ − 4a becomes 3³ − 4(3)"
        },
        {
          "type": "text",
          "value": "Result: 3³ − 4(3)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Evaluate the cube.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3³ = 3 × 3 × 3"
        },
        {
          "type": "text",
          "value": "Result: 27 − 4(3)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Evaluate the multiplication.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4 × 3 = 12"
        },
        {
          "type": "text",
          "value": "Result: 27 − 12"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Subtract.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 15"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Replace a with 3, work out the cube, work out the product, then subtract."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "a³ − 4a = 15"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "An index tells you how many times the base is used as a factor, so a³ with a = 3 means 3 × 3 × 3. The coefficient 4 in 4a is a separate instruction to multiply. Keeping those two ideas apart is what makes the substitution come out right."
    }
  ],

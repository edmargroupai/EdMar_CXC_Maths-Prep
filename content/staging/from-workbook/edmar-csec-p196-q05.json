  "stemBlocks": [
    {
      "type": "text",
      "value": "The matrix C = (−2 5 1 / 4 0 −3). (a) Calculate 3C. (b) Calculate −2C."
    },
    {
      "type": "text",
      "value": "Think first: Multiplying a matrix by a number simply multiplies every single entry by that number; the order of the matrix does not change."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p196_q05.jpg",
      "altText": "Source visual for edmar-csec-p196-q05 from workbook page 196."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply every entry of C by 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(−2) = −6; 3(5) = 15; 3(1) = 3; 3(4) = 12; 3(0) = 0; 3(−3) = −9"
        },
        {
          "type": "text",
          "value": "Result: 3C = (−6 15 3 / 12 0 −9)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply every entry of C by −2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2(−2) = 4; −2(5) = −10; −2(1) = −2; −2(4) = −8; −2(0) = 0; −2(−3) = 6"
        },
        {
          "type": "text",
          "value": "Result: −2C = (4 −10 −2 / −8 0 6)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Check the order of each answer.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Scalar multiplication never changes the shape."
        },
        {
          "type": "text",
          "value": "Result: Both answers are 2 × 3"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply each of the six entries by 3, then repeat with −2, keeping careful track of signs."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(a) 3C = (−6 15 3 / 12 0 −9)  (b) −2C = (4 −10 −2 / −8 0 6)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A scalar multiplies each element independently, so it stretches every entry by the same factor and leaves the shape untouched. A negative scalar also flips the sign of every entry, which is why the two negative entries in C become positive in −2C. Zero entries stay zero whatever the scalar."
    }
  ],

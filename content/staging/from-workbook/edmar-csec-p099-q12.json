  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 2x + 5y = 29 and 3x + 4y = 27."
    },
    {
      "type": "text",
      "value": "Think first: Both equations have plus signs throughout, so after matching one pair of coefficients you will subtract rather than add."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p099_q12.jpg",
      "altText": "Source visual for edmar-csec-p099-q12 from workbook page 99."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the first equation by 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 × (2x + 5y = 29)"
        },
        {
          "type": "text",
          "value": "Result: 6x + 15y = 87"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply the second equation by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × (3x + 4y = 27)"
        },
        {
          "type": "text",
          "value": "Result: 6x + 8y = 54"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract the second new equation from the first to remove x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(15y − 8y) = 87 − 54"
        },
        {
          "type": "text",
          "value": "Result: 7y = 33"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide to find y, keeping it exact.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "33 ÷ 7"
        },
        {
          "type": "text",
          "value": "Result: y = 33/7"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Substitute into 2x + 5y = 29.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x + 165/7 = 29 = 203/7, so 2x = 38/7"
        },
        {
          "type": "text",
          "value": "Result: x = 19/7"
        }
      ]
    },
    {
      "stepNo": 6,
      "instruction": "Check in the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(19/7) + 4(33/7) = (57 + 132)/7 = 189/7"
        },
        {
          "type": "text",
          "value": "Result: 27 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply the first equation by 3 and the second by 2 to match the x terms, subtract to eliminate x, then substitute back."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 19/7, y = 33/7 (that is, x = 2 5/7 and y = 4 5/7)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Scaling both equations so the x coefficients agree lets a single subtraction remove x entirely. The solution is the intersection point of the two lines, and there is no requirement for that point to have integer coordinates — the exact fractions are the exact answer."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations x + 2y = 8 and 2x − y = 1."
    },
    {
      "type": "text",
      "value": "Think first: No coefficients match yet, so either rearrange one equation for substitution or scale one for elimination."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p098_q08.jpg",
      "altText": "Source visual for edmar-csec-p098-q08 from workbook page 98."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Rearrange the second equation to make y the subject.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x − y = 1 gives 2x − 1 = y"
        },
        {
          "type": "text",
          "value": "Result: y = 2x − 1"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute into the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x + 2(2x − 1) = 8"
        },
        {
          "type": "text",
          "value": "Result: x + 4x − 2 = 8"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Simplify and solve for x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5x = 10"
        },
        {
          "type": "text",
          "value": "Result: x = 2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Substitute back to find y.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y = 2(2) − 1"
        },
        {
          "type": "text",
          "value": "Result: y = 3"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 + 2(3) = 2 + 6"
        },
        {
          "type": "text",
          "value": "Result: 8 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Make y the subject of the second equation and substitute into the first."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 2, y = 3"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Because y = 2x − 1 holds for every point on the second line, replacing y in the first equation keeps that equation true only at the crossing point. Solving the resulting single-variable equation therefore pins down the shared solution exactly."
    }
  ],

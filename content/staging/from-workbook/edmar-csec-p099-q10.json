  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 2(x + y) = 18 and 3x − 2y = 7."
    },
    {
      "type": "text",
      "value": "Think first: Simplify the bracketed equation before you do anything else — it hides a very simple relationship."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p099_q10.jpg",
      "altText": "Source visual for edmar-csec-p099-q10 from workbook page 99."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Divide the first equation by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2(x + y) = 18"
        },
        {
          "type": "text",
          "value": "Result: x + y = 9"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Make x the subject.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x = 9 − y"
        },
        {
          "type": "text",
          "value": "Result: x = 9 − y"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute into the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(9 − y) − 2y = 7, so 27 − 3y − 2y = 7"
        },
        {
          "type": "text",
          "value": "Result: 27 − 5y = 7"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Solve for y.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−5y = −20"
        },
        {
          "type": "text",
          "value": "Result: y = 4"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Substitute back to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x = 9 − 4"
        },
        {
          "type": "text",
          "value": "Result: x = 5"
        }
      ]
    },
    {
      "stepNo": 6,
      "instruction": "Check in the original first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2(5 + 4) = 2(9)"
        },
        {
          "type": "text",
          "value": "Result: 18 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Divide the first equation by 2 to get x + y = 9, make x the subject and substitute into the second equation."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 5, y = 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Dividing an equation by a common factor changes nothing about its solutions but makes the numbers far easier to handle. Once the first equation is reduced to x + y = 9, substitution converts the pair into a single equation in y that solves in two lines."
    }
  ],

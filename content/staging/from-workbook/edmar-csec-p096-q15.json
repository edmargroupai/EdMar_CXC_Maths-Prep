  "stemBlocks": [
    {
      "type": "text",
      "value": "Make x the subject of the formula y = (3x − 4)/(x + 2)."
    },
    {
      "type": "text",
      "value": "Think first: x appears twice, so the plan is to clear the fraction, gather every x term on one side and factorise."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p096_q15.jpg",
      "altText": "Source visual for edmar-csec-p096-q15 from workbook page 96."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply both sides by (x + 2).",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y(x + 2) = 3x − 4"
        },
        {
          "type": "text",
          "value": "Result: y(x + 2) = 3x − 4"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Expand the left-hand side.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "yx + 2y = 3x − 4"
        },
        {
          "type": "text",
          "value": "Result: yx + 2y = 3x − 4"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Collect the x terms on one side and everything else on the other.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "yx − 3x = −4 − 2y"
        },
        {
          "type": "text",
          "value": "Result: yx − 3x = −4 − 2y"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Factorise out x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x(y − 3) = −(2y + 4)"
        },
        {
          "type": "text",
          "value": "Result: x(y − 3) = −(2y + 4)"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Divide by (y − 3) and tidy the signs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x = −(2y + 4)/(y − 3) = (2y + 4)/(3 − y)"
        },
        {
          "type": "text",
          "value": "Result: x = (2y + 4)/(3 − y)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply both sides by (x + 2), expand, collect the x terms together, factorise out x and divide."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = (2y + 4)/(3 − y), equivalently x = −(2y + 4)/(y − 3)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "When the new subject appears more than once, no sequence of simple inverse operations can isolate it. Clearing the fraction turns the formula into a linear equation in x, and factorising collects the scattered x terms into a single factor that can then be divided away."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the equation 8x − 2(3x − 8) = 24."
    },
    {
      "type": "text",
      "value": "Think first: The bracket is multiplied by −2, so both terms inside it change sign on expansion."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p054_q06.jpg",
      "altText": "Source visual for edmar-csec-p054-q06 from workbook page 54."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Expand the bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2 × 3x = −6x and −2 × (−8) = +16"
        },
        {
          "type": "text",
          "value": "Result: 8x − 6x + 16 = 24"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Collect the like terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8x − 6x = 2x"
        },
        {
          "type": "text",
          "value": "Result: 2x + 16 = 24"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract 16 from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "24 − 16"
        },
        {
          "type": "text",
          "value": "Result: 2x = 8"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide both sides by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: x = 4"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check by substitution.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8(4) − 2(12 − 8) = 32 − 8"
        },
        {
          "type": "text",
          "value": "Result: 24, which matches"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand −2(3x − 8), collect like terms, then isolate x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Multiplying a bracket by a negative number reverses the sign of every term inside, so −2(3x − 8) becomes −6x + 16 rather than −6x − 16. After expansion the left side collapses to a single linear expression, and the equation is unwound by subtracting the constant and dividing by the coefficient of x. Each of those operations is applied to both sides, which is what keeps the equation balanced."
    }
  ],

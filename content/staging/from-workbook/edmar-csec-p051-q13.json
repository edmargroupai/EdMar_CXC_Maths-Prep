  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify (6x + 5)/4 + (5x − 3)/6 as a single fraction."
    },
    {
      "type": "text",
      "value": "Think first: The lowest common multiple of 4 and 6 is 12, not 24 — using the smallest one keeps the arithmetic clean."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p051_q13.jpg",
      "altText": "Source visual for edmar-csec-p051-q13 from workbook page 51."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the lowest common denominator of 4 and 6.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "LCM of 4 and 6"
        },
        {
          "type": "text",
          "value": "Result: 12"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Rewrite each fraction over 12.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(6x + 5) is multiplied by 3; (5x − 3) is multiplied by 2"
        },
        {
          "type": "text",
          "value": "Result: [3(6x + 5) + 2(5x − 3)]/12"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Expand the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "18x + 15 and 10x − 6"
        },
        {
          "type": "text",
          "value": "Result: 18x + 15 + 10x − 6"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Collect like terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "18x + 10x = 28x and 15 − 6 = 9"
        },
        {
          "type": "text",
          "value": "Result: 28x + 9"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Rewrite both fractions over 12, expand the numerators, then collect like terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(28x + 9)/12"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Each fraction is multiplied top and bottom by whatever turns its denominator into 12, so its value is untouched while its form becomes compatible with the other. Addition then applies only to numerators. Although 28 and 12 share a factor of 4, the constant 9 does not, so no common factor runs through the whole numerator and the fraction is already in its simplest form."
    }
  ],

  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute a = 3 and b = 4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3² + 4"
        },
        {
          "type": "text",
          "value": "Result: 9 + 4"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 13"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute a = 3 and b = 4 into a² + b and evaluate."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "3 o 4 = 13"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The definition tells you exactly what to do with the left and right inputs. Only the first number is², so the order of operations - index before addition - decides the answer."
    }
  ],

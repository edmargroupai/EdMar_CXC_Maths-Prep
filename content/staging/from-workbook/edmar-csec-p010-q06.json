  "stemBlocks": [
    {
      "type": "text",
      "value": "Calculate (6.4 × 10⁵)/(8 × 10²) and give your answer: (i) exactly  (ii) in standard form."
    },
    {
      "type": "text",
      "value": "Think first: Deal with the ordinary numbers and the powers of ten as two separate divisions."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p010_q06.jpg",
      "altText": "Source visual for edmar-csec-p010-q06 from workbook page 10."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Split the quotient into two parts.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(6.4 ÷ 8) × (10⁵ ÷ 10²)"
        },
        {
          "type": "text",
          "value": "Result: (6.4 ÷ 8) × 10³"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide the front numbers.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6.4 ÷ 8 = 64 ÷ 80"
        },
        {
          "type": "text",
          "value": "Result: 0.8"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Give the exact value.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "0.8 × 1000"
        },
        {
          "type": "text",
          "value": "Result: 800"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Rewrite in standard form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "0.8 = 8 × 10⁻¹, so 8 × 10⁻¹ × 10³"
        },
        {
          "type": "text",
          "value": "Result: 8 × 10²"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Divide 6.4 by 8, subtract the indices for the powers of ten, then adjust the front number so it lies between 1 and 10."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(i) 800 exactly  (ii) 8 × 10²"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Dividing powers of ten subtracts their indices, since each matching factor of ten cancels between numerator and denominator. The front number 0.8 is below 1, so it is not yet standard form; moving the decimal point one place right multiplies it by 10, which must be paid for by reducing the index from 10³ to 10². The value never changes — only the way it is written."
    }
  ],

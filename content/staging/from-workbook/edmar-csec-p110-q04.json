  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations x + y = 7 and x² + y² = 25."
    },
    {
      "type": "text",
      "value": "Think first: Substitute from the linear equation and expect to expand a squared bracket carefully."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p110_q04.jpg",
      "altText": "Source visual for edmar-csec-p110-q04 from workbook page 110."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Make y the subject of the linear equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "from x + y = 7"
        },
        {
          "type": "text",
          "value": "Result: y = 7 − x"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute and expand the square.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(7 − x)² = 49 − 14x + x²"
        },
        {
          "type": "text",
          "value": "Result: x² + 49 − 14x + x² = 25"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Collect terms and rearrange.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x² − 14x + 49 − 25 = 0"
        },
        {
          "type": "text",
          "value": "Result: 2x² − 14x + 24 = 0"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide through by 2 and factorise.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² − 7x + 12 = 0, so (x − 3)(x − 4) = 0"
        },
        {
          "type": "text",
          "value": "Result: x = 3 or x = 4"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Find the matching y-values.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y = 7 − 3 = 4; y = 7 − 4 = 3"
        },
        {
          "type": "text",
          "value": "Result: (3, 4) and (4, 3)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Write y = 7 − x, substitute into x² + y² = 25, expand and simplify to a quadratic, then solve and pair the answers."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 3, y = 4 or x = 4, y = 3"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Squaring the substituted expression is where care is needed: (7 − x)² is not 49 − x², it carries the middle term −14x. Once expanded, the two x² terms combine and the system collapses to a single quadratic. Geometrically the line x + y = 7 is a chord of the circle x² + y² = 25, meeting it at two points."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: x² + 7x."
    },
    {
      "type": "text",
      "value": "Think first: The common factor here is a letter, not a number."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q05.jpg",
      "altText": "Source visual for edmar-csec-p066-q05 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write each term as a product.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² = x × x and 7x = 7 × x"
        },
        {
          "type": "text",
          "value": "Result: x is in both"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Identify the HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "The coefficients 1 and 7 share only 1"
        },
        {
          "type": "text",
          "value": "Result: HCF = x"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide each term by x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² ÷ x = x and 7x ÷ x = 7"
        },
        {
          "type": "text",
          "value": "Result: x and 7"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: x(x + 7)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Recognise that x divides both terms, take it out, and write the remainder in a bracket."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x² + 7x = x(x + 7)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A common factor does not have to be a number. Since x² means x × x, one x can be lifted out of both terms, leaving x and 7 behind. Expanding x(x + 7) gives x² + 7x, confirming that nothing has been gained or lost."
    }
  ],

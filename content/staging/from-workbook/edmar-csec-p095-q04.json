  "stemBlocks": [
    {
      "type": "text",
      "value": "Make r the subject of the formula C = 2πr (the circumference of a circle)."
    },
    {
      "type": "text",
      "value": "Think first: π is just a number here, so 2π is a single coefficient multiplying r."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p095_q04.jpg",
      "altText": "Source visual for edmar-csec-p095-q04 from workbook page 95."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Identify what is multiplying r.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "C = 2π × r"
        },
        {
          "type": "text",
          "value": "Result: the coefficient is 2π"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide both sides by 2π.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "C ÷ 2π = 2πr ÷ 2π"
        },
        {
          "type": "text",
          "value": "Result: C/(2π) = r"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Write the new subject on the left.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: r = C/(2π)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Treat 2π as one number and divide both sides by it."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "r = C/(2π)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "π is a constant, so 2π behaves like any ordinary number multiplying r. Dividing both sides by that whole coefficient undoes the multiplication in one move and gives a formula that lets you find a radius directly from a measured circumference."
    }
  ],

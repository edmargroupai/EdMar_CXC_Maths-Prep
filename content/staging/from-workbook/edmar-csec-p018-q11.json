  "stemBlocks": [
    {
      "type": "text",
      "value": "Calculate: a. 25% of 3 600  b. 12.5% of 8 000."
    },
    {
      "type": "text",
      "value": "Think first: Both percentages have simple fraction equivalents, so no long multiplication is needed."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p018_q11.jpg",
      "altText": "Source visual for edmar-csec-p018-q11 from workbook page 18."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Convert 25% to a fraction.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "25/100"
        },
        {
          "type": "text",
          "value": "Result: 1/4"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find a quarter of 3 600.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3600 ÷ 4"
        },
        {
          "type": "text",
          "value": "Result: 900"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Convert 12.5% to a fraction.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "12.5/100 = 125/1000"
        },
        {
          "type": "text",
          "value": "Result: 1/8"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Find an eighth of 8 000.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8000 ÷ 8"
        },
        {
          "type": "text",
          "value": "Result: 1000"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Convert each percentage to its fraction and divide."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "a. 900  b. 1 000"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A percentage is a fraction with denominator 100, so finding a percentage of a quantity is always multiplication by that fraction. Recognising 25% as 1/4 and 12.5% as 1/8 replaces a multiplication and a division by a single division, which is faster and much harder to get wrong without a calculator."
    }
  ],

  "examTip": [
    {
      "type": "text",
      "value": "Memorise the common conversions — 10% = 1/10, 12.5% = 1/8, 20% = 1/5, 25% = 1/4, 33 1/3% = 1/3, 50% = 1/2 — they turn most non-calculator percentage questions into one division."
    }

  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 2x² + 13x + 20"
    },
    {
      "type": "text",
      "value": "Think first: When the coefficient of x² is not 1, the two numbers must multiply to a × c, not just to c."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p093_q16.jpg",
      "altText": "Source visual for edmar-csec-p093-q16 from workbook page 93."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the first and last coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × 20"
        },
        {
          "type": "text",
          "value": "Result: 40"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find two numbers with product 40 and sum 13.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5 and 8"
        },
        {
          "type": "text",
          "value": "Result: 5 and 8"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Split the middle term and group.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x² + 5x + 8x + 20 = x(2x + 5) + 4(2x + 5)"
        },
        {
          "type": "text",
          "value": "Result: (2x + 5)(x + 4)"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x² + 8x + 5x + 20"
        },
        {
          "type": "text",
          "value": "Result: 2x² + 13x + 20"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply the first and last coefficients, find two numbers with that product and with sum equal to the middle coefficient, split the middle term and factorise by grouping."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(2x + 5)(x + 4)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "When the coefficient of x² is not 1 the two numbers must multiply to a × c, because that coefficient is shared between the brackets. Splitting the middle term turns the trinomial into four terms, which grouping then handles in the usual way."
    }
  ],

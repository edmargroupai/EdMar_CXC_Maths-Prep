  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 16x²y² − 121z²"
    },
    {
      "type": "text",
      "value": "Think first: Take the square root of every part of each term — number and letters alike."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p092_q10.jpg",
      "altText": "Source visual for edmar-csec-p092-q10 from workbook page 92."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write each term as a square.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "16x²y² = (4xy)² and 121z² = (11z)²"
        },
        {
          "type": "text",
          "value": "Result: (4xy)² − (11z)²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Apply the difference of two squares.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Here a = 4xy and b = 11z"
        },
        {
          "type": "text",
          "value": "Result: (4xy − 11z)(4xy + 11z)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Write both terms as squares and apply a² − b² = (a − b)(a + b)."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(4xy − 11z)(4xy + 11z)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Squaring a product squares each of its parts, so the square root of 16x²y² is 4xy. With both terms written as squares the rule applies directly, and expanding the two brackets cancels the middle terms to return the original expression."
    }
  ],

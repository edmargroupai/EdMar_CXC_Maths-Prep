  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 3x + 2y = 11 and x + y = 5."
    },
    {
      "type": "text",
      "value": "Think first: The second equation has a coefficient of 1, which makes substitution the quickest route."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p098_q05.jpg",
      "altText": "Source visual for edmar-csec-p098-q05 from workbook page 98."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Make y the subject of the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x + y = 5"
        },
        {
          "type": "text",
          "value": "Result: y = 5 − x"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute this into the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3x + 2(5 − x) = 11"
        },
        {
          "type": "text",
          "value": "Result: 3x + 10 − 2x = 11"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Simplify and solve for x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x + 10 = 11"
        },
        {
          "type": "text",
          "value": "Result: x = 1"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Substitute back to find y.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y = 5 − 1"
        },
        {
          "type": "text",
          "value": "Result: y = 4"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(1) + 2(4) = 3 + 8"
        },
        {
          "type": "text",
          "value": "Result: 11 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Rearrange x + y = 5 to make y the subject, substitute into the first equation and solve for x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 1, y = 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Substitution replaces one unknown by an expression that is guaranteed to be equal to it, so the resulting equation carries exactly the same information but involves only one letter. Both equations still hold, which is why the values found satisfy the pair."
    }
  ],

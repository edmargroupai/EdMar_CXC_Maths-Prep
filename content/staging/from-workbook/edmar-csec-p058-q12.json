  "stemBlocks": [
    {
      "type": "text",
      "value": "A binary operation is defined by a △ b = (a + b)/2. Evaluate (6 △ 4) △ 8."
    },
    {
      "type": "text",
      "value": "Think first: This operation takes the average of its two inputs, so do the bracket first and then average again."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p058_q12.jpg",
      "altText": "Source visual for edmar-csec-p058-q12 from workbook page 58."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Evaluate the bracket 6 △ 4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(6 + 4)/2 = 10/2"
        },
        {
          "type": "text",
          "value": "Result: 6 △ 4 = 5"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Replace the bracket by 5.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 5 △ 8"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Apply the rule with a = 5, b = 8.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(5 + 8)/2 = 13/2"
        },
        {
          "type": "text",
          "value": "Result: 6.5"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Evaluate 6 △ 4 inside the bracket, then combine that result with 8 using the same rule."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(6 △ 4) △ 8 = 6.5, that is 13/2"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The rule is simply the mean of the two numbers. Averaging is not associative: averaging 6 and 4 first and then with 8 gives 6.5, whereas averaging 4 and 8 first would give 6 - so the bracket controls the answer, and a non-integer result is perfectly normal."
    }
  ],

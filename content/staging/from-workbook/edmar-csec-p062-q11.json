  "stemBlocks": [
    {
      "type": "text",
      "value": "If x = −2, evaluate (x + 3)²."
    },
    {
      "type": "text",
      "value": "Think first: The bracket must be settled before the square, so deal with the addition first."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p062_q11.jpg",
      "altText": "Source visual for edmar-csec-p062-q11 from workbook page 62."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute x = −2 into the bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x + 3) becomes (−2 + 3)"
        },
        {
          "type": "text",
          "value": "Result: (−2 + 3)²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Simplify inside the bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2 + 3 = 1"
        },
        {
          "type": "text",
          "value": "Result: (1)²"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Square the result.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "1 × 1"
        },
        {
          "type": "text",
          "value": "Result: 1"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Put −2 in place of x, simplify inside the bracket, then square the single number you are left with."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(x + 3)² = 1"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Brackets act as a wrapper: everything inside is reduced to a single number before the power outside applies to it. Squaring first would square only x, not the whole bracket, which is a different expression. Working inside-out keeps the meaning of the original expression intact."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify (10 × 5x³) / (25x²)."
    },
    {
      "type": "text",
      "value": "Think first: Only the x terms carry indices here; the 10 is a plain number."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p065_q20.jpg",
      "altText": "Source visual for edmar-csec-p065-q20 from workbook page 65."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the coefficients in the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "10 × 5 = 50"
        },
        {
          "type": "text",
          "value": "Result: 50x³"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "50 ÷ 25 = 2"
        },
        {
          "type": "text",
          "value": "Result: 2"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract the indices.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x³ ÷ x² = x^(3−2)"
        },
        {
          "type": "text",
          "value": "Result: 2x"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the answer.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x¹ is written simply as x"
        },
        {
          "type": "text",
          "value": "Result: 2x"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply the numerator out, then divide the coefficients and subtract the indices."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(10 × 5x³) / (25x²) = 2x"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A term with no visible index has index 1, so x³ ÷ x² leaves x¹, written as x. The numbers and the letters are independent factors, which is why the coefficients can be divided separately from the powers. Recognising that the constant 10 carries no x at all keeps it out of the index arithmetic."
    }
  ],

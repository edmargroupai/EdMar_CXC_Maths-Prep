  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the equation x(x − 5) = 14."
    },
    {
      "type": "text",
      "value": "Think first: You cannot set each factor to zero yet — the right-hand side is 14, not 0, so expand and rearrange first."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p104_q06.jpg",
      "altText": "Source visual for edmar-csec-p104-q06 from workbook page 104."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Expand the left-hand side.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x × x − x × 5"
        },
        {
          "type": "text",
          "value": "Result: x² − 5x = 14"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Subtract 14 from both sides to reach standard form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² − 5x − 14 = 0"
        },
        {
          "type": "text",
          "value": "Result: x² − 5x − 14 = 0"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Find two numbers multiplying to −14 and adding to −5.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−7 × 2 = −14 and −7 + 2 = −5"
        },
        {
          "type": "text",
          "value": "Result: −7 and +2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Factorise and solve each bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x − 7)(x + 2) = 0"
        },
        {
          "type": "text",
          "value": "Result: x = 7 or x = −2"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand the left side, bring everything to one side to make the equation equal zero, then factorise."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 7 or x = −2"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The zero product property only applies when the product equals zero, so the rearrangement to x² − 5x − 14 = 0 is not optional. Writing x = 14 or x − 5 = 14 from the original form is invalid because 14 can be split into many pairs of factors. Once in standard form the usual factorising method applies."
    }
  ],

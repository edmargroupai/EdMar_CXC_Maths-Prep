  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 12 + 8y."
    },
    {
      "type": "text",
      "value": "Think first: Both 12 and 8 are even, but 2 is not the largest factor they share."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q03.jpg",
      "altText": "Source visual for edmar-csec-p066-q03 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Factors of 12: 1, 2, 3, 4, 6, 12. Factors of 8: 1, 2, 4, 8"
        },
        {
          "type": "text",
          "value": "Result: HCF = 4"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Check for a common letter.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "12 has no y, so y is not common"
        },
        {
          "type": "text",
          "value": "Result: HCF stays 4"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide each term by 4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "12 ÷ 4 = 3 and 8y ÷ 4 = 2y"
        },
        {
          "type": "text",
          "value": "Result: 3 and 2y"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 4(3 + 2y)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find the HCF of 12 and 8, take it outside a bracket, and divide each term by it."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "12 + 8y = 4(3 + 2y)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Factorising completely means removing the highest common factor, not just any common factor. Taking out 2 would leave 2(6 + 4y), which still has a common factor of 2 inside the bracket and so is not finished. Only when the bracket has no remaining common factor is the expression fully factorised."
    }
  ],

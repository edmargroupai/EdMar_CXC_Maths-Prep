  "stemBlocks": [
    {
      "type": "text",
      "value": "Expand and simplify (x + 1)(x − 8)."
    },
    {
      "type": "text",
      "value": "Think first: One bracket adds and one subtracts, so the constant term will be negative."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p053_q03.jpg",
      "altText": "Source visual for edmar-csec-p053-q03 from workbook page 53."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the first terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x × x"
        },
        {
          "type": "text",
          "value": "Result: x²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply the outer and inner pairs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x × (−8) = −8x and 1 × x = x"
        },
        {
          "type": "text",
          "value": "Result: −8x + x"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Multiply the last terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "1 × (−8), positive times negative is negative"
        },
        {
          "type": "text",
          "value": "Result: −8"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Collect the middle terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−8x + x = −7x"
        },
        {
          "type": "text",
          "value": "Result: x² − 7x − 8"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand all four products with attention to the mixed signs, then collect the x-terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x² − 7x − 8"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "With one positive and one negative number, their product is negative, so the constant term is −8. Their sum, 1 + (−8) = −7, gives the coefficient of x. Whenever a quadratic ends in a negative constant you know the two brackets must carry opposite signs, which is a useful check in both directions."
    }
  ],

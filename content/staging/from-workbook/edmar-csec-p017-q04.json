  "stemBlocks": [
    {
      "type": "text",
      "value": "The simple interest on a sum of money invested at 5% per annum for 2 years was $600. Calculate the principal invested."
    },
    {
      "type": "text",
      "value": "Think first: The unknown here is the principal, so rearrange the formula rather than substituting into it directly."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p017_q04.jpg",
      "altText": "Source visual for edmar-csec-p017-q04 from workbook page 17."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the formula with the known values.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "600 = (P × 5 × 2)/100"
        },
        {
          "type": "text",
          "value": "Result: 600 = 10P/100"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Simplify the right-hand side.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "10/100 = 0.1"
        },
        {
          "type": "text",
          "value": "Result: 600 = 0.1P"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Solve for P.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "P = 600 ÷ 0.1"
        },
        {
          "type": "text",
          "value": "Result: $6000"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check the answer.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(6000 × 5 × 2)/100 = 600"
        },
        {
          "type": "text",
          "value": "Result: Checks out"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute R = 5, T = 2 and I = 600 into I = PRT/100 and solve for P."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "$6 000"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Simple interest is directly proportional to the principal, so the ratio between interest and principal is fixed by the rate and time alone: at 5% for 2 years the interest is always one tenth of whatever is invested. That is why dividing the interest by 0.1 recovers the principal, and why the check is just the original formula run forwards."
    }
  ],

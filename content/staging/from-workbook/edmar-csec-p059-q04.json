  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the inequality 4x + 5 ≤ 21."
    },
    {
      "type": "text",
      "value": "Think first: Undo the addition first, then the multiplication."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p059_q04.jpg",
      "altText": "Source visual for edmar-csec-p059-q04 from workbook page 59."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract 5 from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4x ≤ 21 − 5"
        },
        {
          "type": "text",
          "value": "Result: 4x ≤ 16"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide both sides by 4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4x/4 ≤ 16/4"
        },
        {
          "type": "text",
          "value": "Result: x ≤ 4"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract 5 from both sides, then divide by 4."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x ≤ 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The same inverse operations that solve 4x + 5 = 21 also solve the inequality, because both sides are changed by identical positive amounts. The result x ≤ 4 describes every number from 4 downwards, with 4 itself included."
    }
  ],

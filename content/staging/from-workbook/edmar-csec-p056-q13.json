  "stemBlocks": [
    {
      "type": "text",
      "value": "Make y the subject of the equation 3x + 2y = 12."
    },
    {
      "type": "text",
      "value": "Think first: Move everything that is not y to the other side, then divide by y's coefficient."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p056_q13.jpg",
      "altText": "Source visual for edmar-csec-p056-q13 from workbook page 56."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract 3x from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3x + 2y - 3x = 12 - 3x"
        },
        {
          "type": "text",
          "value": "Result: 2y = 12 - 3x"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide every term by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2y/2 = (12 - 3x)/2"
        },
        {
          "type": "text",
          "value": "Result: y = (12 - 3x)/2"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Split the fraction to show gradient form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(12 - 3x)/2 = 6 - 1.5x"
        },
        {
          "type": "text",
          "value": "Result: y = 6 - 1.5x"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract 3x from both sides, then divide by 2."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "y = (12 - 3x)/2, that is y = 6 - 1.5x"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Making y the subject turns the equation into the form y = mx + c, so you can read the gradient (-1.5) and the y-intercept (6) straight off. Dividing by 2 must be applied to every term on the right, not just the first, because the whole expression was on one side of the equation."
    }
  ],

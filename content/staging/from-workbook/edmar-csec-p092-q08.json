  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 25a² − 64b²"
    },
    {
      "type": "text",
      "value": "Think first: Both terms are perfect squares and they are subtracted — use the difference of two squares."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p092_q08.jpg",
      "altText": "Source visual for edmar-csec-p092-q08 from workbook page 92."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write each term as a square.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "25a² = (5a)² and 64b² = (8b)²"
        },
        {
          "type": "text",
          "value": "Result: (5a)² − (8b)²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Apply the difference of two squares.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Here a = 5a and b = 8b"
        },
        {
          "type": "text",
          "value": "Result: (5a − 8b)(5a + 8b)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Write each term as a square, then apply a² − b² = (a − b)(a + b)."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(5a − 8b)(5a + 8b)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The square root of 25a² is 5a because both the number and the letter are square-rooted. Expanding (5a − 8b)(5a + 8b) cancels the two middle terms and returns 25a² − 64b², which confirms the factorisation."
    }
  ],

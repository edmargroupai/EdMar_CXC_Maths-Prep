  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations x + y = 10 and x − y = 2."
    },
    {
      "type": "text",
      "value": "Think first: Adding removes y and subtracting removes x, so either move gives an instant result."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p097_q03.jpg",
      "altText": "Source visual for edmar-csec-p097-q03 from workbook page 97."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Add the two equations.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x + x) + (y − y) = 10 + 2"
        },
        {
          "type": "text",
          "value": "Result: 2x = 12"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "12 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: x = 6"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute x = 6 into x + y = 10.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6 + y = 10"
        },
        {
          "type": "text",
          "value": "Result: y = 4"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check in the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6 − 4"
        },
        {
          "type": "text",
          "value": "Result: 2 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Add the equations to find x, then substitute into either equation to find y."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 6, y = 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A sum-and-difference pair is the simplest kind of simultaneous system: adding gives twice the larger unknown and subtracting gives twice the smaller one. The point (6, 4) is the only pair that satisfies both conditions at once."
    }
  ],

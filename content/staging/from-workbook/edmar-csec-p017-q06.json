  "stemBlocks": [
    {
      "type": "text",
      "value": "$10 000 is invested at 6% per annum compound interest, compounded annually for 2 years. Calculate the total amount."
    },
    {
      "type": "text",
      "value": "Think first: With compound interest each year's interest joins the principal, so the second year earns on more than the first."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p017_q06.jpg",
      "altText": "Source visual for edmar-csec-p017-q06 from workbook page 17."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the compound interest formula.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "A = P(1 + R/100)ⁿ"
        },
        {
          "type": "text",
          "value": "Result: A = 10000 × 1.06²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find the amount after one year.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "10000 × 1.06"
        },
        {
          "type": "text",
          "value": "Result: $10 600"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Apply the same increase to the new balance.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "10600 × 1.06"
        },
        {
          "type": "text",
          "value": "Result: $11 236"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "State the total amount.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Equivalently 10000 × 1.1236"
        },
        {
          "type": "text",
          "value": "Result: $11 236"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Multiply the principal by 1.06 once for each year, or use A = P(1 + R/100)ⁿ with n = 2."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "$11 236"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A 6% increase multiplies a balance by 1.06, so applying it twice multiplies by 1.06² — this is why compound growth is repeated multiplication rather than repeated addition. The extra $36 above the $11 200 that simple interest would give is precisely the 6% earned on the first year's $600 of interest."
    }
  ],

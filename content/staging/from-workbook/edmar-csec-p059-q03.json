  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the inequality 2(3x − 1) < 10."
    },
    {
      "type": "text",
      "value": "Think first: Clear the bracket first, then isolate x."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p059_q03.jpg",
      "altText": "Source visual for edmar-csec-p059-q03 from workbook page 59."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Expand the bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × 3x − 2 × 1"
        },
        {
          "type": "text",
          "value": "Result: 6x − 2 < 10"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add 2 to both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6x < 10 + 2"
        },
        {
          "type": "text",
          "value": "Result: 6x < 12"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide both sides by 6.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6x/6 < 12/6"
        },
        {
          "type": "text",
          "value": "Result: x < 2"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand the bracket, add 2 to both sides, then divide by 6."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x < 2"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Expanding is safe here because the multiplier 2 is positive; multiplying an inequality by a positive number keeps its direction. You could also divide both sides by 2 first to get 3x − 1 < 5, which is quicker and reaches the same answer."
    }
  ],

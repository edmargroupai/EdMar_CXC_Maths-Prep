  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 15x² + 20xy − 9x − 12y"
    },
    {
      "type": "text",
      "value": "Think first: A negative third term again — expect to take out a negative factor from the second pair."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p092_q05.jpg",
      "altText": "Source visual for edmar-csec-p092-q05 from workbook page 92."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Group the terms in pairs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(15x² + 20xy) + (−9x − 12y)"
        },
        {
          "type": "text",
          "value": "Result: Two pairs"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Take the common factor out of each pair.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5x from the first pair; −3 from the second"
        },
        {
          "type": "text",
          "value": "Result: 5x(3x + 4y) − 3(3x + 4y)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Take out the common bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(3x + 4y) appears in both terms"
        },
        {
          "type": "text",
          "value": "Result: (3x + 4y)(5x − 3)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Take 5x out of the first pair and −3 out of the second so the brackets agree, then take out the common bracket."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(3x + 4y)(5x − 3)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Choosing −3 rather than +3 makes the second bracket read 3x + 4y, matching the first. A shared bracket behaves like a shared number, so it lifts straight out and turns the sum into a product."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations x − y = 1 and x² + y = 5."
    },
    {
      "type": "text",
      "value": "Think first: Rearrange the linear equation for y, then substitute into the equation containing x squared."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p110_q02.jpg",
      "altText": "Source visual for edmar-csec-p110-q02 from workbook page 110."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Make y the subject of the linear equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "from x − y = 1"
        },
        {
          "type": "text",
          "value": "Result: y = x − 1"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute into the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² + (x − 1) = 5"
        },
        {
          "type": "text",
          "value": "Result: x² + x − 1 = 5"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Rearrange into standard form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "subtract 5 from both sides"
        },
        {
          "type": "text",
          "value": "Result: x² + x − 6 = 0"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Factorise and solve.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x + 3)(x − 2) = 0"
        },
        {
          "type": "text",
          "value": "Result: x = −3 or x = 2"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Find the matching y-values.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y = −3 − 1 = −4; y = 2 − 1 = 1"
        },
        {
          "type": "text",
          "value": "Result: (−3, −4) and (2, 1)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Write y = x − 1, substitute into x² + y = 5, solve the resulting quadratic and pair each root with its y."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = −3, y = −4 or x = 2, y = 1"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Because y appears only to the first power in both equations, isolating it is straightforward and the substitution leaves a quadratic in x alone. Two roots means the line x − y = 1 cuts the parabola y = 5 − x² twice. Each pair satisfies both originals: for (−3, −4), −3 − (−4) = 1 and 9 + (−4) = 5."
    }
  ],

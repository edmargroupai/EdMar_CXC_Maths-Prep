  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 7x + 3y = 31 and 4x + 3y = 10."
    },
    {
      "type": "text",
      "value": "Think first: Both equations contain +3y, so subtract one from the other to eliminate y."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p100_q14.jpg",
      "altText": "Source visual for edmar-csec-p100-q14 from workbook page 100."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract the second equation from the first.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(7x − 4x) + (3y − 3y) = 31 − 10"
        },
        {
          "type": "text",
          "value": "Result: 3x = 21"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "21 ÷ 3"
        },
        {
          "type": "text",
          "value": "Result: x = 7"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute x = 7 into 4x + 3y = 10.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "28 + 3y = 10, so 3y = −18"
        },
        {
          "type": "text",
          "value": "Result: y = −6"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7(7) + 3(−6) = 49 − 18"
        },
        {
          "type": "text",
          "value": "Result: 31 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract the second equation from the first, solve for x, then substitute back to find y."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 7, y = −6"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "When one unknown has the same coefficient and the same sign in both equations, the difference of the equations contains only the other unknown. Nothing prevents a solution from being negative — the crossing point of the two lines simply lies below the x-axis."
    }
  ],

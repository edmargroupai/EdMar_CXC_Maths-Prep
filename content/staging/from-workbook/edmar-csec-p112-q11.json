  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations x − y = 2 and xy = 15."
    },
    {
      "type": "text",
      "value": "Think first: The second equation is a product, so substitute from the linear equation to get a single quadratic."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p112_q11.jpg",
      "altText": "Source visual for edmar-csec-p112-q11 from workbook page 112."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Make x the subject of the linear equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x − y = 2"
        },
        {
          "type": "text",
          "value": "Result: x = y + 2"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute x = y + 2 into xy = 15.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(y + 2)y = 15"
        },
        {
          "type": "text",
          "value": "Result: y² + 2y = 15"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Write the quadratic in standard form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y² + 2y − 15 = 0"
        },
        {
          "type": "text",
          "value": "Result: y² + 2y − 15 = 0"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Factorise and solve for y.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(y + 5)(y − 3) = 0"
        },
        {
          "type": "text",
          "value": "Result: y = 3 or y = −5"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Find the matching x from x = y + 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y = 3 → x = 5;  y = −5 → x = −3"
        },
        {
          "type": "text",
          "value": "Result: (5, 3) and (−3, −5)"
        }
      ]
    },
    {
      "stepNo": 6,
      "instruction": "Check each pair satisfies xy = 15.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5 × 3 = 15 and (−3) × (−5) = 15"
        },
        {
          "type": "text",
          "value": "Result: Both pairs verified"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Rearrange x − y = 2 to x = y + 2, substitute into xy = 15 and solve the quadratic in y, then find each matching x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 5, y = 3  or  x = −3, y = −5"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Substitution turns a two-variable system into one quadratic whose roots are the possible values of one variable. Because a product of two negatives is positive, the negative pair (−3, −5) is a genuine solution and not an error — the equations never said the numbers had to be positive."
    }
  ],

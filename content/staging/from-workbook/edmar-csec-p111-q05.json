  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations y = x + 1 and x² + y² = 25."
    },
    {
      "type": "text",
      "value": "Think first: y is already isolated, so substitute straight into the circle equation and expand."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p111_q05.jpg",
      "altText": "Source visual for edmar-csec-p111-q05 from workbook page 111."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute y = x + 1 into the second equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x + 1)² = x² + 2x + 1"
        },
        {
          "type": "text",
          "value": "Result: x² + x² + 2x + 1 = 25"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Collect like terms and rearrange.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x² + 2x + 1 − 25 = 0"
        },
        {
          "type": "text",
          "value": "Result: 2x² + 2x − 24 = 0"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide every term by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "common factor of 2 throughout"
        },
        {
          "type": "text",
          "value": "Result: x² + x − 12 = 0"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Factorise and solve.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x + 4)(x − 3) = 0"
        },
        {
          "type": "text",
          "value": "Result: x = −4 or x = 3"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Find the matching y-values.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y = −4 + 1 = −3; y = 3 + 1 = 4"
        },
        {
          "type": "text",
          "value": "Result: (−4, −3) and (3, 4)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Replace y with x + 1 in x² + y² = 25, expand, simplify to a quadratic, then solve and pair the results."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = −4, y = −3 or x = 3, y = 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The substitution turns a two-variable system into one quadratic, whose roots are the x-coordinates of the two points where the line meets the circle of radius 5. Dividing by the common factor 2 simplifies the factorising without changing the roots. Both pairs check out, since (−4)² + (−3)² = 25 and 3² + 4² = 25."
    }
  ],

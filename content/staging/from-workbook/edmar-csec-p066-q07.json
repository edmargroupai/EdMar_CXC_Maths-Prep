  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 6ab + 9a."
    },
    {
      "type": "text",
      "value": "Think first: Both a number and a letter are shared by the two terms."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q07.jpg",
      "altText": "Source visual for edmar-csec-p066-q07 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6 and 9 share the factor 3"
        },
        {
          "type": "text",
          "value": "Result: 3"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find the common letter.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "a appears in both terms; b appears only in the first"
        },
        {
          "type": "text",
          "value": "Result: a"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Combine into the full HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 × a"
        },
        {
          "type": "text",
          "value": "Result: 3a"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide each term by 3a.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6ab ÷ 3a = 2b and 9a ÷ 3a = 3"
        },
        {
          "type": "text",
          "value": "Result: 2b and 3"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 3a(2b + 3)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find the numerical HCF and the common letter separately, then combine them into one factor."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "6ab + 9a = 3a(2b + 3)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The highest common factor is built from every part shared by all the terms: the largest common number and the letters that appear in each term to the lowest power they occur. Handling the number and the letter separately and then multiplying them together is what guarantees nothing common is left behind."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "A binary operation is defined by a o b = a + b². Find 2 o 3."
    },
    {
      "type": "text",
      "value": "Think first: Only the second number is² here - check the definition before you calculate."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p057_q06.jpg",
      "altText": "Source visual for edmar-csec-p057-q06 from workbook page 57."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute a = 2 and b = 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 + 3²"
        },
        {
          "type": "text",
          "value": "Result: 2 + 9"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 11"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute a = 2 and b = 3 into a + b², squaring first."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "2 o 3 = 11"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The index applies only to b, so squaring happens before the addition. Compare this with the earlier rule a² + b: the same two inputs give a different answer, which is why the definition must be read every time rather than remembered from the previous question."
    }
  ],

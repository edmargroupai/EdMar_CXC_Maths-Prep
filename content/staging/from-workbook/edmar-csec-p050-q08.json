  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify 5/(x − 1) + 2/(x + 3) as a single fraction."
    },
    {
      "type": "text",
      "value": "Think first: Get both fractions over the same denominator first; the addition then happens on the numerators alone."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p050_q08.jpg",
      "altText": "Source visual for edmar-csec-p050-q08 from workbook page 50."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Form the common denominator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "multiply the two unrelated brackets"
        },
        {
          "type": "text",
          "value": "Result: (x − 1)(x + 3)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Rewrite each fraction over that denominator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5 is multiplied by (x + 3); 2 is multiplied by (x − 1)"
        },
        {
          "type": "text",
          "value": "Result: [5(x + 3) + 2(x − 1)]/[(x − 1)(x + 3)]"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Expand the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5x + 15 and 2x − 2"
        },
        {
          "type": "text",
          "value": "Result: 5x + 15 + 2x − 2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Collect like terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5x + 2x = 7x and 15 − 2 = 13"
        },
        {
          "type": "text",
          "value": "Result: 7x + 13"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Take (x − 1)(x + 3) as the common denominator, rewrite both numerators, then expand and simplify."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(7x + 13)/[(x − 1)(x + 3)]"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Two fractions can be added only when they are expressed in the same units, and the common denominator supplies those units. Each fraction is multiplied by a disguised 1 — (x + 3)/(x + 3) or (x − 1)/(x − 1) — so its value is preserved while its form changes. The result is left with a factorised denominator because that form is simplest and shows the excluded values x = 1 and x = −3."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify (9x^(1/2) × 3x⁴) / (3x⁵ × 6x²)."
    },
    {
      "type": "text",
      "value": "Think first: Fractional indices obey exactly the same addition and subtraction rules as whole-number ones."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p065_q19.jpg",
      "altText": "Source visual for edmar-csec-p065-q19 from workbook page 65."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Simplify the numerator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9 × 3 = 27 and x^(1/2) × x⁴ = x^(1/2 + 4)"
        },
        {
          "type": "text",
          "value": "Result: 27x^(9/2)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Simplify the denominator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 × 6 = 18 and x⁵ × x² = x^(5+2)"
        },
        {
          "type": "text",
          "value": "Result: 18x⁷"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "27 ÷ 18 = 3/2"
        },
        {
          "type": "text",
          "value": "Result: 3/2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Subtract the indices.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9/2 − 7 = 9/2 − 14/2"
        },
        {
          "type": "text",
          "value": "Result: x^(−5/2)"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Write the negative index as a fraction.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x^(−5/2) = 1/x^(5/2)"
        },
        {
          "type": "text",
          "value": "Result: 3/(2x^(5/2))"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Collapse the numerator and the denominator each into a single term, then divide the coefficients and subtract the indices."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(9x^(1/2) × 3x⁴) / (3x⁵ × 6x²) = (3/2)x^(−5/2), that is 3/(2x^(5/2))"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Indices need not be whole numbers for the laws to hold; x^(1/2) is just the square root of x, and adding 1/2 to 4 is the same kind of operation as adding 1 to 4. Writing 4 as 8/2 and 7 as 14/2 keeps every index over the same denominator so the arithmetic stays reliable. The final negative index is then rewritten as a fraction to present the answer in its usual form."
    }
  ],

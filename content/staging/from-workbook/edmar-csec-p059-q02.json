  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the inequality 5y + 1 ≤ 3y + 9."
    },
    {
      "type": "text",
      "value": "Think first: Collect the y terms on the left and the constants on the right, then divide."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p059_q02.jpg",
      "altText": "Source visual for edmar-csec-p059-q02 from workbook page 59."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract 3y from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5y − 3y + 1 ≤ 9"
        },
        {
          "type": "text",
          "value": "Result: 2y + 1 ≤ 9"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Subtract 1 from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2y ≤ 9 − 1"
        },
        {
          "type": "text",
          "value": "Result: 2y ≤ 8"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide both sides by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2y/2 ≤ 8/2"
        },
        {
          "type": "text",
          "value": "Result: y ≤ 4"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract 3y and then 1 from both sides, and finally divide by 2."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "y ≤ 4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Dividing by the positive number 2 leaves the direction of the inequality untouched. The ≤ sign means 4 is included in the solution, so y = 4 is a valid answer - substituting it gives 21 ≤ 21, which is true."
    }
  ],

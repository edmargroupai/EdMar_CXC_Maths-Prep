  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 9m − 12n."
    },
    {
      "type": "text",
      "value": "Think first: The letters are different, so only a number can come out."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q04.jpg",
      "altText": "Source visual for edmar-csec-p066-q04 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Factors of 9: 1, 3, 9. Factors of 12: 1, 2, 3, 4, 6, 12"
        },
        {
          "type": "text",
          "value": "Result: HCF = 3"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Note that m and n are different letters.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "No letter appears in both terms"
        },
        {
          "type": "text",
          "value": "Result: No letter in the HCF"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide each term by 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9m ÷ 3 = 3m and 12n ÷ 3 = 4n"
        },
        {
          "type": "text",
          "value": "Result: 3m and 4n"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 3(3m − 4n)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find the HCF of 9 and 12, take it outside a bracket, and divide each term by it."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "9m − 12n = 3(3m − 4n)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A factor can only be taken out if it appears in every term. Since m is absent from 12n and n is absent from 9m, neither letter is common and only the numerical HCF can be removed. The bracket that is left, 3m − 4n, has no further common factor, so the factorisation is complete."
    }
  ],

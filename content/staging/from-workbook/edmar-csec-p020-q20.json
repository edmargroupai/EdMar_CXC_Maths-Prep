  "stemBlocks": [
    {
      "type": "text",
      "value": "A shopkeeper marks up goods by 25%. Calculate the selling price of an item that cost $3 200."
    },
    {
      "type": "text",
      "value": "Think first: A mark-up is added to the cost price, so the selling price is more than 100% of the cost."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p020_q20.jpg",
      "altText": "Source visual for edmar-csec-p020-q20 from workbook page 20."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the selling price as a percentage of the cost price.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "100% + 25%"
        },
        {
          "type": "text",
          "value": "Result: 125%"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Convert to a multiplier.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "125 / 100"
        },
        {
          "type": "text",
          "value": "Result: 1.25"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Multiply the cost price by the multiplier.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "$3 200 x 1.25"
        },
        {
          "type": "text",
          "value": "Result: $4 000"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by finding the mark-up separately.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "25% of $3 200 = $800, then $3 200 + $800"
        },
        {
          "type": "text",
          "value": "Result: $4 000"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Add the mark-up percentage to 100% and multiply the cost price by the resulting multiplier."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "The selling price is $4 000."
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Mark-up is always calculated on the cost price, the amount the shopkeeper paid. Adding the percentage to 100% before multiplying keeps everything in one step and avoids losing the original amount. The $800 mark-up is the gross profit on the item."
    }
  ],

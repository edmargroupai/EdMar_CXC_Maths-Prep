  "stemBlocks": [
    {
      "type": "text",
      "value": "Make C the subject of the formula F = 9C/5 + 32 (the Fahrenheit–Celsius conversion)."
    },
    {
      "type": "text",
      "value": "Think first: Strip away the +32 first, then unwind the fraction 9/5 that multiplies C."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p095_q09.jpg",
      "altText": "Source visual for edmar-csec-p095-q09 from workbook page 95."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract 32 from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "F − 32 = 9C/5"
        },
        {
          "type": "text",
          "value": "Result: F − 32 = 9C/5"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply both sides by 5 to clear the denominator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5(F − 32) = 9C"
        },
        {
          "type": "text",
          "value": "Result: 5(F − 32) = 9C"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide both sides by 9.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5(F − 32) ÷ 9"
        },
        {
          "type": "text",
          "value": "Result: 5(F − 32)/9 = C"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the new subject on the left.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: C = 5(F − 32)/9"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract 32, multiply by 5, then divide by 9."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "C = 5(F − 32)/9"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "To build F from C you multiply by 9, divide by 5 and add 32; reversing that chain in the opposite order gives subtract 32, multiply by 5, divide by 9. Bracketing F − 32 keeps the whole difference attached to the multiplication, which is what makes the conversion correct at every temperature."
    }
  ],

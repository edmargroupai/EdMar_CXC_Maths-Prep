  "stemBlocks": [
    {
      "type": "text",
      "value": "Determine the coordinates of the midpoint of the line segment joining A(−3, 5) and B(7, −1)."
    },
    {
      "type": "text",
      "value": "Think first: The midpoint is just the average of the two x-values paired with the average of the two y-values."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p126_q01.jpg",
      "altText": "Source visual for edmar-csec-p126-q01 from workbook page 126."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the midpoint formula and label the coordinates.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "A(x₁, y₁) = (−3, 5), B(x₂, y₂) = (7, −1)"
        },
        {
          "type": "text",
          "value": "Result: M = ((x₁ + x₂)/2, (y₁ + y₂)/2)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Average the x-coordinates.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−3 + 7)/2 = 4/2"
        },
        {
          "type": "text",
          "value": "Result: x = 2"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Average the y-coordinates.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(5 + (−1))/2 = 4/2"
        },
        {
          "type": "text",
          "value": "Result: y = 2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the midpoint as an ordered pair.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Combine the two averages"
        },
        {
          "type": "text",
          "value": "Result: M(2, 2)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Apply the midpoint formula ((x₁ + x₂)/2, (y₁ + y₂)/2) to A and B."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "The midpoint is (2, 2)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The midpoint sits halfway along the segment, so its horizontal position is halfway between the two x-values and its vertical position halfway between the two y-values. Averaging each coordinate separately is exactly what 'halfway' means, which is why the formula works for any pair of points, negatives included."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Express x² + 10x − 7 in the form (x + h)² + k by completing the square."
    },
    {
      "type": "text",
      "value": "Think first: Half of 10 is 5, and the constant here is already negative, so expect a large negative k."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p101_q03.jpg",
      "altText": "Source visual for edmar-csec-p101-q03 from workbook page 101."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Halve the coefficient of x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "10 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: 5, so the bracket is (x + 5)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Expand to see the surplus.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x + 5)² = x² + 10x + 25"
        },
        {
          "type": "text",
          "value": "Result: 25 too many"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract 25 and add the original constant −7.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² + 10x − 7 = (x + 5)² − 25 − 7"
        },
        {
          "type": "text",
          "value": "Result: (x + 5)² − 32"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² + 10x + 25 − 32"
        },
        {
          "type": "text",
          "value": "Result: x² + 10x − 7 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Form (x + 5)², subtract the 25 it introduces and add the original constant −7."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x² + 10x − 7 = (x + 5)² − 32"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Completing the square rewrites a quadratic as a single squared term plus a constant, which is possible for every quadratic even when it will not factorise into whole-number brackets. The correction −25 and the original −7 simply combine into one constant."
    }
  ],

    {
      "type": "text",
      "value": "Solve the inequality 3x − 7 > 2x + 5."
    },
    {
      "type": "text",
      "value": "Think first: Treat it like an equation: gather the x terms on one side and the numbers on the other."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p059_q01.jpg",
      "altText": "Source visual for edmar-csec-p059-q01 from workbook page 59."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract 2x from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3x − 2x − 7 > 5"
        },
        {
          "type": "text",
          "value": "Result: x − 7 > 5"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add 7 to both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x > 5 + 7"
        },
        {
          "type": "text",
          "value": "Result: x > 12"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract 2x from both sides, then add 7 to both sides."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x > 12"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Adding or subtracting the same quantity from both sides never disturbs an inequality, so the > sign is carried through unchanged. The answer is a range, not a single number: every value greater than 12 satisfies the original statement, and 12 itself does not."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the equation 3(x − 2) = 15."
    },
    {
      "type": "text",
      "value": "Think first: The bracket is multiplied by 3, so you can either expand it or divide both sides by 3 first."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p054_q02.jpg",
      "altText": "Source visual for edmar-csec-p054-q02 from workbook page 54."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Divide both sides by 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "15 ÷ 3 = 5"
        },
        {
          "type": "text",
          "value": "Result: x − 2 = 5"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add 2 to both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5 + 2"
        },
        {
          "type": "text",
          "value": "Result: x = 7"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Check by substitution.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3(7 − 2) = 3 × 5"
        },
        {
          "type": "text",
          "value": "Result: 15, which matches the right-hand side"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Divide both sides by 3 to clear the bracket, then add 2 to isolate x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 7"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Because the entire bracket is multiplied by 3, dividing both sides by 3 undoes that multiplication in one move and leaves a much simpler equation. Expanding first to 3x − 6 = 15 reaches the same answer, since the two routes are just different orders of applying the same inverse operations. Choosing the division route avoids handling the −6 altogether."
    }
  ],

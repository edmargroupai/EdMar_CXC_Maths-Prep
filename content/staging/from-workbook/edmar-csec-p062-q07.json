  "stemBlocks": [
    {
      "type": "text",
      "value": "If a = 2, b = −3 and c = 0, find 4a − 2b + 3c."
    },
    {
      "type": "text",
      "value": "Think first: Three terms to evaluate; watch the double negative in the middle one."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p062_q07.jpg",
      "altText": "Source visual for edmar-csec-p062-q07 from workbook page 62."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute the values.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4(2) − 2(−3) + 3(0)"
        },
        {
          "type": "text",
          "value": "Result: 8 − (−6) + 0"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Simplify the double negative.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "subtracting −6 is adding 6"
        },
        {
          "type": "text",
          "value": "Result: 8 + 6 + 0"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Add.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 14"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute each value with brackets, evaluate each term, then combine."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "14"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The term −2b means −2 multiplied by b, and with b = −3 that product is +6. Anything multiplied by c = 0 vanishes, so the third term contributes nothing - but it is still worth writing down to show the substitution was complete."
    }
  ],

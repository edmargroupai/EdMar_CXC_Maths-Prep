  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the equation 5x − 3(x − 1) = 39."
    },
    {
      "type": "text",
      "value": "Think first: Expand the bracket first, watching that the minus sign multiplies both terms inside it."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p054_q05.jpg",
      "altText": "Source visual for edmar-csec-p054-q05 from workbook page 54."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Expand the bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−3 × x = −3x and −3 × (−1) = +3"
        },
        {
          "type": "text",
          "value": "Result: 5x − 3x + 3 = 39"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Collect the like terms on the left.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5x − 3x = 2x"
        },
        {
          "type": "text",
          "value": "Result: 2x + 3 = 39"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract 3 from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "39 − 3"
        },
        {
          "type": "text",
          "value": "Result: 2x = 36"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide both sides by 2.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "36 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: x = 18"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check by substitution.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5(18) − 3(18 − 1) = 90 − 51"
        },
        {
          "type": "text",
          "value": "Result: 39, which matches"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand −3(x − 1), collect the x-terms, then isolate x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 18"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The term −3(x − 1) means the whole bracket is subtracted three times, so both of its terms change sign when expanded — that is where the +3 comes from. Once the left side is a single linear expression, the equation is solved by undoing the operations in reverse order: subtract the constant, then divide by the coefficient. Substituting back confirms the sign work was correct."
    }
  ],

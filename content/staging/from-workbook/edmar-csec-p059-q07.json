  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract y from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2y − y − 6 ≥ 4"
        },
        {
          "type": "text",
          "value": "Result: y − 6 ≥ 4"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add 6 to both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "y ≥ 4 + 6"
        },
        {
          "type": "text",
          "value": "Result: y ≥ 10"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract y from both sides, then add 6."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "y ≥ 10"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Because the coefficient of y is already 1 after collecting terms, no division is needed and the ≥ sign is never at risk. The boundary value y = 10 satisfies the inequality exactly: 14 ≥ 14."
    }
  ],

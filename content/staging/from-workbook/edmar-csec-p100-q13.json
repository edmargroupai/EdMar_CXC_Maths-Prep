  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 5x − 4y = 18 and 2x − 4y = 6."
    },
    {
      "type": "text",
      "value": "Think first: Both equations contain −4y, so subtracting one from the other removes y immediately."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p100_q13.jpg",
      "altText": "Source visual for edmar-csec-p100-q13 from workbook page 100."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract the second equation from the first.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(5x − 2x) + (−4y + 4y) = 18 − 6"
        },
        {
          "type": "text",
          "value": "Result: 3x = 12"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "12 ÷ 3"
        },
        {
          "type": "text",
          "value": "Result: x = 4"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute x = 4 into 2x − 4y = 6.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8 − 4y = 6, so −4y = −2"
        },
        {
          "type": "text",
          "value": "Result: y = 1/2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5(4) − 4(1/2) = 20 − 2"
        },
        {
          "type": "text",
          "value": "Result: 18 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract the second equation from the first to eliminate y, solve for x, then substitute back."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 4, y = 1/2"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Identical y terms in both equations mean the difference between the equations contains no y at all, so subtraction isolates x in one step. The half in the answer is genuine: the two lines simply meet at a point whose y coordinate is not a whole number."
    }
  ],

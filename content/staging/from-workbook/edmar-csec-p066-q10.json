  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 3x³ + 6x²."
    },
    {
      "type": "text",
      "value": "Think first: The common power of x is the lower one, x², not x³."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q10.jpg",
      "altText": "Source visual for edmar-csec-p066-q10 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 and 6 share the factor 3"
        },
        {
          "type": "text",
          "value": "Result: 3"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Find the lowest power of x common to both terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x³ and x² both contain x²"
        },
        {
          "type": "text",
          "value": "Result: x²"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Combine into the full HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 × x²"
        },
        {
          "type": "text",
          "value": "Result: 3x²"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide each term by 3x².",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3x³ ÷ 3x² = x and 6x² ÷ 3x² = 2"
        },
        {
          "type": "text",
          "value": "Result: x and 2"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 3x²(x + 2)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Take the HCF of the coefficients together with the lowest power of x present in both terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "3x³ + 6x² = 3x²(x + 2)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A power can only be taken out as far as the smallest index present, because that is all every term has to give. Since x³ contains x² with one x to spare, and x² contains x² exactly, the common factor is x². Dividing then uses the index law x³ ÷ x² = x^(3−2), which is why a single x remains in the bracket."
    }
  ],

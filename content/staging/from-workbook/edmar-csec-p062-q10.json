  "stemBlocks": [
    {
      "type": "text",
      "value": "If m = 6, find the value of m² − 5m."
    },
    {
      "type": "text",
      "value": "Think first: Substitution just means swapping the letter for its number, then following the order of operations."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p062_q10.jpg",
      "altText": "Source visual for edmar-csec-p062-q10 from workbook page 62."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the expression with 6 in place of m.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "m² − 5m becomes 6² − 5(6)"
        },
        {
          "type": "text",
          "value": "Result: 6² − 5(6)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Evaluate the power.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6² = 6 × 6"
        },
        {
          "type": "text",
          "value": "Result: 36 − 5(6)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Evaluate the multiplication.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "5 × 6 = 30"
        },
        {
          "type": "text",
          "value": "Result: 36 − 30"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Subtract.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 6"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Replace every m with 6, work out the power first, then the multiplication, then the subtraction."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "m² − 5m = 6"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "An algebraic expression is a set of instructions waiting for a number. Once m is fixed at 6, the expression becomes ordinary arithmetic, and the usual order of operations decides what happens first: the index, then the multiplication, then the subtraction. Doing the subtraction early would answer a different calculation entirely."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Expand and simplify (x − 4)(x − 3)."
    },
    {
      "type": "text",
      "value": "Think first: Two negative numbers multiply to give a positive constant, but their sum makes the middle term negative."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p052_q04.jpg",
      "altText": "Source visual for edmar-csec-p052-q04 from workbook page 52."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the first terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x × x"
        },
        {
          "type": "text",
          "value": "Result: x²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply the outer and inner pairs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x × (−3) = −3x and (−4) × x = −4x"
        },
        {
          "type": "text",
          "value": "Result: −3x − 4x"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Multiply the last terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−4) × (−3), negative times negative is positive"
        },
        {
          "type": "text",
          "value": "Result: +12"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Collect the middle terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−3x − 4x = −7x"
        },
        {
          "type": "text",
          "value": "Result: x² − 7x + 12"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand term by term, keeping the signs attached to the numbers, then collect the x-terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x² − 7x + 12"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Each number keeps its sign throughout the expansion, so the two cross-products are both negative and add to −7x, while the product of the two negatives turns positive. This is why a quadratic with a positive constant and a negative middle term factorises into two brackets that both contain minus signs. Sign discipline, not new mathematics, is what makes this expansion different from the all-positive ones."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the equation 6x − 8(3x − 8) = 24."
    },
    {
      "type": "text",
      "value": "Think first: The bracket carries a large multiplier, so the x-coefficient will end up negative — that is fine."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p054_q07.jpg",
      "altText": "Source visual for edmar-csec-p054-q07 from workbook page 54."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Expand the bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−8 × 3x = −24x and −8 × (−8) = +64"
        },
        {
          "type": "text",
          "value": "Result: 6x − 24x + 64 = 24"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Collect the like terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6x − 24x = −18x"
        },
        {
          "type": "text",
          "value": "Result: −18x + 64 = 24"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract 64 from both sides.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "24 − 64 = −40"
        },
        {
          "type": "text",
          "value": "Result: −18x = −40"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Divide both sides by −18.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−40 ÷ −18, a negative divided by a negative is positive"
        },
        {
          "type": "text",
          "value": "Result: x = 40/18"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Simplify the fraction.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "divide numerator and denominator by 2"
        },
        {
          "type": "text",
          "value": "Result: x = 20/9"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand −8(3x − 8), collect the x-terms, then divide through by the resulting coefficient."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 20/9 (approximately 2.22)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Expanding a bracket by −8 changes the sign of both of its terms, turning −8 × (−8) into +64. Collecting then gives a negative coefficient of x, but dividing both sides by that negative number restores a positive solution because both sides are negative. The final fraction is reduced by cancelling the common factor 2, which does not change its value."
    }
  ],

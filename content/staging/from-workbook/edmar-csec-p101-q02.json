  "stemBlocks": [
    {
      "type": "text",
      "value": "Express x² − 8x + 3 in the form (x + h)² + k by completing the square."
    },
    {
      "type": "text",
      "value": "Think first: The x coefficient is negative, so the number inside the bracket is negative too."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p101_q02.jpg",
      "altText": "Source visual for edmar-csec-p101-q02 from workbook page 101."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Halve the coefficient of x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−8 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: −4, so the bracket is (x − 4)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Expand to see the surplus.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(x − 4)² = x² − 8x + 16"
        },
        {
          "type": "text",
          "value": "Result: 16 too many"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Subtract 16 and add the original constant 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² − 8x + 3 = (x − 4)² − 16 + 3"
        },
        {
          "type": "text",
          "value": "Result: (x − 4)² − 13"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x² − 8x + 16 − 13"
        },
        {
          "type": "text",
          "value": "Result: x² − 8x + 3 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Halve −8 to form (x − 4)², subtract the 16 this introduces, then add the original constant 3."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x² − 8x + 3 = (x − 4)² − 13"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The identity (x − h)² = x² − 2hx + h² means half the x coefficient always sits inside the bracket, sign included. Because squaring −4 still gives a positive 16, that surplus must be subtracted, which is why k ends up well below the original constant."
    }
  ],

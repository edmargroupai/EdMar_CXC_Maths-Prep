  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: 4t² − t."
    },
    {
      "type": "text",
      "value": "Think first: The second term is 1 × t, and that 1 must not disappear."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q06.jpg",
      "altText": "Source visual for edmar-csec-p066-q06 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write each term as a product.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4t² = 4 × t × t and t = 1 × t"
        },
        {
          "type": "text",
          "value": "Result: t is in both"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Identify the HCF.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Coefficients 4 and 1 share only 1"
        },
        {
          "type": "text",
          "value": "Result: HCF = t"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide each term by t.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "4t² ÷ t = 4t and t ÷ t = 1"
        },
        {
          "type": "text",
          "value": "Result: 4t and 1"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: t(4t − 1)"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "t × 4t − t × 1"
        },
        {
          "type": "text",
          "value": "Result: 4t² − t"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Take out the common letter t and be careful about what the second term leaves behind."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "4t² − t = t(4t − 1)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Dividing a term by itself leaves 1, not nothing. Because t ÷ t = 1, the bracket must contain −1 to preserve the original expression. Dropping that 1 would change 4t² − t into 4t², a different expression altogether, which is why expanding back is such a reliable check."
    }
  ],

    {
      "type": "text",
      "value": "If p = 2, q = −3 and r = −1, find pq + pr."
    },
    {
      "type": "text",
      "value": "Think first: Two products, both involving a negative, then a sum."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p061_q05.jpg",
      "altText": "Source visual for edmar-csec-p061-q05 from workbook page 61."
    }

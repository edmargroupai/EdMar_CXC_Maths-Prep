  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Evaluate pq.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(2)(−3)"
        },
        {
          "type": "text",
          "value": "Result: −6"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Evaluate pr.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(2)(−1)"
        },
        {
          "type": "text",
          "value": "Result: −2"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Add the two results.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−6 + (−2)"
        },
        {
          "type": "text",
          "value": "Result: −8"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute and evaluate each product separately, then add them."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "−8"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Each term is worked out on its own before they are combined, which keeps the signs manageable. Adding a negative is the same as subtracting, so −6 + (−2) moves further down the number line to −8. You could also factorise first: pq + pr = p(q + r) = 2(−4) = −8, which is a useful check."
    }
  ],

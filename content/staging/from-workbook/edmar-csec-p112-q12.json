  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations y = 2x + 3 and xy = 14."
    },
    {
      "type": "text",
      "value": "Think first: The first equation already gives y in terms of x, so substitution is immediate."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p112_q12.jpg",
      "altText": "Source visual for edmar-csec-p112-q12 from workbook page 112."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute y = 2x + 3 into xy = 14.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x(2x + 3) = 14"
        },
        {
          "type": "text",
          "value": "Result: 2x² + 3x = 14"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Write the quadratic in standard form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x² + 3x − 14 = 0"
        },
        {
          "type": "text",
          "value": "Result: 2x² + 3x − 14 = 0"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Factorise.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Split 3x as 7x − 4x: 2x² + 7x − 4x − 14 = x(2x + 7) − 2(2x + 7)"
        },
        {
          "type": "text",
          "value": "Result: (2x + 7)(x − 2) = 0"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Solve for x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x + 7 = 0 or x − 2 = 0"
        },
        {
          "type": "text",
          "value": "Result: x = −3.5 or x = 2"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Find the matching y from y = 2x + 3.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x = 2 → y = 7;  x = −3.5 → y = −4"
        },
        {
          "type": "text",
          "value": "Result: (2, 7) and (−3.5, −4)"
        }
      ]
    },
    {
      "stepNo": 6,
      "instruction": "Check each pair in xy = 14.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2 × 7 = 14 and (−3.5) × (−4) = 14"
        },
        {
          "type": "text",
          "value": "Result: Both pairs verified"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute y = 2x + 3 into xy = 14, solve the quadratic 2x² + 3x − 14 = 0, then find each matching y."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 2, y = 7  or  x = −3.5, y = −4"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Substituting the expression for y directly into the product equation produces a quadratic whose two roots are the two x-values where the line meets the curve xy = 14. Because the coefficient of x² is 2, the factorisation needs a split of the middle term, but the logic is unchanged: each factor set to zero gives one intersection."
    }
  ],

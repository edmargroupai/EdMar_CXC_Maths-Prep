  "stemBlocks": [
    {
      "type": "text",
      "value": "The function p is defined by p(x) = 7 − 2x. (a) Find x when p(x) = 15. (b) Find x when p(x) = 0."
    },
    {
      "type": "text",
      "value": "Think first: You are given the output and asked for the input, so set the rule equal to the value and solve."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p121_q03.jpg",
      "altText": "Source visual for edmar-csec-p121-q03 from workbook page 121."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Set the rule equal to 15.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7 − 2x = 15"
        },
        {
          "type": "text",
          "value": "Result: 7 − 2x = 15"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Solve for x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−2x = 15 − 7 = 8, so x = 8 ÷ (−2)"
        },
        {
          "type": "text",
          "value": "Result: x = −4"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Set the rule equal to 0.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7 − 2x = 0"
        },
        {
          "type": "text",
          "value": "Result: 7 − 2x = 0"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Solve for x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2x = 7, so x = 7 ÷ 2"
        },
        {
          "type": "text",
          "value": "Result: x = 3.5"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check both answers in the rule.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "p(−4) = 7 + 8 = 15;  p(3.5) = 7 − 7 = 0"
        },
        {
          "type": "text",
          "value": "Result: Both verified"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Set 7 − 2x equal to each given value in turn and solve the resulting linear equation for x."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(a) x = −4  (b) x = 3.5"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Evaluating a function takes you from input to output; solving p(x) = c reverses that journey. Because the coefficient of x is negative, a larger output corresponds to a smaller input — which is why asking for an output of 15, above the value p(0) = 7, produces a negative x."
    }
  ],

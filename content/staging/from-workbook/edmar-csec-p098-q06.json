  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 2x − y = 4 and x + y = 5."
    },
    {
      "type": "text",
      "value": "Think first: One equation has −y and the other +y, so adding them removes y at once."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p098_q06.jpg",
      "altText": "Source visual for edmar-csec-p098-q06 from workbook page 98."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Add the two equations.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(2x + x) + (−y + y) = 4 + 5"
        },
        {
          "type": "text",
          "value": "Result: 3x = 9"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9 ÷ 3"
        },
        {
          "type": "text",
          "value": "Result: x = 3"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute x = 3 into x + y = 5.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "3 + y = 5"
        },
        {
          "type": "text",
          "value": "Result: y = 2"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "2(3) − 2 = 6 − 2"
        },
        {
          "type": "text",
          "value": "Result: 4 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Add the equations to eliminate y, solve for x, then substitute into either equation."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 3, y = 2"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Adding equations is legitimate because equal quantities added to equal quantities stay equal. Choosing the addition that cancels y converts the system into a one-variable equation whose solution must also satisfy the original pair."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Expand and simplify (x − 4)(x − 7)."
    },
    {
      "type": "text",
      "value": "Think first: Both brackets subtract, so expect a negative x-term and a positive constant."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p052_q05.jpg",
      "altText": "Source visual for edmar-csec-p052-q05 from workbook page 52."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Multiply the first terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x × x"
        },
        {
          "type": "text",
          "value": "Result: x²"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Multiply the outer and inner pairs.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "x × (−7) = −7x and (−4) × x = −4x"
        },
        {
          "type": "text",
          "value": "Result: −7x − 4x"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Multiply the last terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(−4) × (−7)"
        },
        {
          "type": "text",
          "value": "Result: +28"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Collect the middle terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−7x − 4x = −11x"
        },
        {
          "type": "text",
          "value": "Result: x² − 11x + 28"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Expand all four products with their signs, then combine the like terms."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x² − 11x + 28"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The middle coefficient is the sum of −4 and −7, and the constant is their product, so both follow directly from the distributive law applied twice. Because both numbers are negative, their sum is more negative while their product is positive. Recognising this pairing in reverse is exactly what lets you factorise x² − 11x + 28 back into (x − 4)(x − 7)."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "The time t taken to complete a job varies inversely as the number of workers n. If 6 workers take 10 hours to complete a job, how long will it take 15 workers?"
    },
    {
      "type": "text",
      "value": "Think first: More workers means less time, so the total work — workers multiplied by hours — stays fixed."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p117_q10.jpg",
      "altText": "Source visual for edmar-csec-p117-q10 from workbook page 117."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Write the variation statement as an equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "t varies inversely as n"
        },
        {
          "type": "text",
          "value": "Result: t = k/n"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Substitute t = 10 and n = 6 to find k.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "10 = k/6"
        },
        {
          "type": "text",
          "value": "Result: k = 60 (worker-hours)"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute n = 15 into t = 60/n.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "t = 60 ÷ 15"
        },
        {
          "type": "text",
          "value": "Result: t = 4 hours"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Write t = k/n, find k from 6 workers taking 10 hours, then substitute n = 15."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "15 workers will take 4 hours"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The constant k = 60 is the total amount of work measured in worker-hours; it belongs to the job, not to the team. Sharing that fixed workload among more people divides the time proportionally, which is exactly what inverse variation describes."
    }
  ],

    {
      "type": "text",
      "value": "Evaluate the expression shown in the crop: (18.2 + 7.8)/(9.5 − 4.5)."
    },
    {
      "type": "text",
      "value": "Think first: Treat the top line and the bottom line as two separate calculations, then divide one by the other."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p009_q18.jpg",
      "altText": "Source visual for edmar-csec-p009-q18 from workbook page 9."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Work out the top line.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "18.2 + 7.8"
        },
        {
          "type": "text",
          "value": "Result: 26"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Work out the bottom line.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "9.5 − 4.5"
        },
        {
          "type": "text",
          "value": "Result: 5"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide the two results.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "26 ÷ 5"
        },
        {
          "type": "text",
          "value": "Result: 5.2"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Complete the numerator, complete the denominator, then carry out the division."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "5.2"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The horizontal bar is a grouping symbol acting on everything above it and everything below it, so the addition and the subtraction are both finished before a single division is done. Because 18.2 + 7.8 gives an exact 26 and 9.5 − 4.5 an exact 5, the quotient is exact and no rounding is required."
    }
  ],

    {
      "type": "text",
      "value": "A binary operation * is defined by a * b = a + 2b. Evaluate 6 * 1."
    },
    {
      "type": "text",
      "value": "Think first: The second input is doubled before it is added."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p058_q09.jpg",
      "altText": "Source visual for edmar-csec-p058-q09 from workbook page 58."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Substitute a = 6 and b = 1.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "6 + 2(1)"
        },
        {
          "type": "text",
          "value": "Result: 6 + 2"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Add.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: 8"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Substitute a = 6 and b = 1 into a + 2b."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "6 * 1 = 8"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "The rule weights the two inputs differently - the right-hand one counts twice - so the operation is not commutative: 1 * 6 would be 13. Matching each number to the correct letter is the entire skill being tested."
    }
  ],

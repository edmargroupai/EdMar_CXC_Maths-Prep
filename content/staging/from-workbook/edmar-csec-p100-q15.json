  "stemBlocks": [
    {
      "type": "text",
      "value": "Solve the simultaneous equations 8x − 5y = 19 and 3x − 5y = −6."
    },
    {
      "type": "text",
      "value": "Think first: The −5y term is common to both equations, so subtraction clears y in one step."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p100_q15.jpg",
      "altText": "Source visual for edmar-csec-p100-q15 from workbook page 100."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Subtract the second equation from the first.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(8x − 3x) + (−5y + 5y) = 19 − (−6)"
        },
        {
          "type": "text",
          "value": "Result: 5x = 25"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide to find x.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "25 ÷ 5"
        },
        {
          "type": "text",
          "value": "Result: x = 5"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Substitute x = 5 into 3x − 5y = −6.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "15 − 5y = −6, so −5y = −21"
        },
        {
          "type": "text",
          "value": "Result: y = 21/5"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check in the first equation.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "8(5) − 5(21/5) = 40 − 21"
        },
        {
          "type": "text",
          "value": "Result: 19 ✓"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Subtract the second equation from the first to eliminate y, solve for x, then substitute back."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "x = 5, y = 21/5 (that is, y = 4 1/5 or 4.2)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Subtracting equations with identical y terms leaves an equation in x alone, and the awkward-looking constant on the right is handled by the ordinary rule that subtracting a negative adds. The fractional y is the exact coordinate of the intersection point."
    }
  ],

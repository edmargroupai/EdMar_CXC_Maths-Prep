  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: −8p − 12."
    },
    {
      "type": "text",
      "value": "Think first: When both terms are negative, taking out a negative factor keeps the bracket tidy."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q09.jpg",
      "altText": "Source visual for edmar-csec-p066-q09 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Find the HCF of the coefficients.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Factors of 8: 1, 2, 4, 8. Factors of 12: 1, 2, 3, 4, 6, 12"
        },
        {
          "type": "text",
          "value": "Result: HCF = 4"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Note both terms are negative.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Taking out −4 makes both bracket terms positive"
        },
        {
          "type": "text",
          "value": "Result: Use −4"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Divide each term by −4.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−8p ÷ −4 = 2p and −12 ÷ −4 = 3"
        },
        {
          "type": "text",
          "value": "Result: 2p and 3"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Write the factorised form.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: −4(2p + 3)"
        }
      ]
    },
    {
      "stepNo": 5,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "−4 × 2p = −8p and −4 × 3 = −12"
        },
        {
          "type": "text",
          "value": "Result: −8p − 12"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Find the HCF of 8 and 12, then take it out as a negative because both terms are negative."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "−8p − 12 = −4(2p + 3)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A negative can be treated as part of the common factor. Dividing a negative term by a negative factor gives a positive result, so both signs inside the bracket flip. The factorisation −4(2p + 3) is preferred because the bracket is left in its simplest positive form, and expanding it returns the original expression exactly."
    }
  ],

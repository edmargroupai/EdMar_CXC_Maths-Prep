  "stemBlocks": [
    {
      "type": "text",
      "value": "Simplify 7/(x + 2) − 3/(x − 4) as a single fraction."
    },
    {
      "type": "text",
      "value": "Think first: The two denominators are different, so build one common denominator before subtracting."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p050_q07.jpg",
      "altText": "Source visual for edmar-csec-p050-q07 from workbook page 50."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Form the common denominator.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "the brackets have no common factor"
        },
        {
          "type": "text",
          "value": "Result: (x + 2)(x − 4)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Rewrite both fractions over it.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7 is multiplied by (x − 4); 3 is multiplied by (x + 2)"
        },
        {
          "type": "text",
          "value": "Result: [7(x − 4) − 3(x + 2)]/[(x + 2)(x − 4)]"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Expand the numerator, keeping the subtraction over the whole second bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7x − 28 − (3x + 6)"
        },
        {
          "type": "text",
          "value": "Result: 7x − 28 − 3x − 6"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Collect like terms.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "7x − 3x = 4x and −28 − 6 = −34"
        },
        {
          "type": "text",
          "value": "Result: 4x − 34"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Use (x + 2)(x − 4) as the common denominator, then expand and collect the numerator carefully with the minus sign."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "(4x − 34)/[(x + 2)(x − 4)], which may also be written 2(2x − 17)/[(x + 2)(x − 4)]"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "Multiplying each fraction top and bottom by the missing bracket rescales it without changing its value, so the two fractions become directly comparable. Subtraction then applies to the numerators only. The minus sign belongs to the entire second numerator, which is why 3(x + 2) must be expanded inside a bracket before the signs are distributed."
    }
  ],

  "stemBlocks": [
    {
      "type": "text",
      "value": "Factorise completely: p(q + 4) + 7(q + 4)."
    },
    {
      "type": "text",
      "value": "Think first: The repeated bracket (q + 4) is itself the common factor."
    },
    {
      "type": "asset",
      "storagePath": "assets/question_visuals/p066_q15.jpg",
      "altText": "Source visual for edmar-csec-p066-q15 from workbook page 66."
    }
  ],
  "solutionSteps": [
    {
      "stepNo": 1,
      "instruction": "Identify what both terms have in common.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "The first term is p × (q + 4), the second is 7 × (q + 4)"
        },
        {
          "type": "text",
          "value": "Result: (q + 4)"
        }
      ]
    },
    {
      "stepNo": 2,
      "instruction": "Divide each term by (q + 4).",
      "contentBlocks": [
        {
          "type": "text",
          "value": "p(q + 4) ÷ (q + 4) = p and 7(q + 4) ÷ (q + 4) = 7"
        },
        {
          "type": "text",
          "value": "Result: p and 7"
        }
      ]
    },
    {
      "stepNo": 3,
      "instruction": "Write the common bracket outside and the remainder in a second bracket.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "Result: (q + 4)(p + 7)"
        }
      ]
    },
    {
      "stepNo": 4,
      "instruction": "Check by expanding.",
      "contentBlocks": [
        {
          "type": "text",
          "value": "(q + 4) × p + (q + 4) × 7"
        },
        {
          "type": "text",
          "value": "Result: p(q + 4) + 7(q + 4)"
        }
      ]
    }
  ],
  "strategyBlocks": [
    {
      "type": "text",
      "value": "Treat (q + 4) as a single object that both terms are multiplied by, take it out, and collect what is left."
    }
  ],
  "finalAnswerBlocks": [
    {
      "type": "text",
      "value": "p(q + 4) + 7(q + 4) = (q + 4)(p + 7)"
    }
  ],
  "whyThisWorks": [
    {
      "type": "text",
      "value": "A common factor does not have to be a single number or letter; a whole bracket can play that role. Here (q + 4) multiplies both terms in exactly the same way that 3 multiplied both terms in 3a + 3b, so the same distributive law applies in reverse. Recognising a repeated bracket is the key step that leads on to factorising by grouping."
    }
  ],
